#!/usr/bin/perl
# net-sms — send an SMS through whichever mechanism is currently working.
#
#   net-sms send +15551234567 gateway3 lost Comcast, now on T-Mobile
#   net-sms providers                 what would be tried, in order, and why not
#   net-sms test +15551234567         send a short "net-sms test from <host>"
#
#   --config F      default /etc/net-mgr/sms.conf
#   --dry-run       pick a provider and stop short of sending
#   --quiet         only the outcome line
#   --provider N    use only this provider (still honours availability)
#
# Exit status is 0 only if a message was actually handed to a provider that
# accepted it. A notifier that exits 0 when nothing was sent is worse than one
# that fails loudly, so every skip and failure is printed unless --quiet.
#
# See etc/sms.conf.sample. Credentials never live in the config file; a
# provider names a secret and NetMgr::Secret reads it from
# /etc/net-mgr/secrets/<name> (root-owned, mode 600).

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
# no_getopt_compat: without it Getopt::Long treats a leading '+' as an option
# prefix, so the recipient '+15551234567' is parsed as options and every E.164
# number fails with "Unknown option: 1".
# require_order: stop parsing at the first non-option, so words in the message
# body that happen to start with '-' are message text, not flags.
use Getopt::Long qw(:config no_ignore_case bundling no_getopt_compat require_order);
use Sys::Hostname qw(hostname);
use NetMgr::SMS;

my ($conf, $dry, $quiet, $only, $help);
my ($listen, $cname, $ckind, $cservice, $cnotes, $cenable, $no_auth);
my (%svc);
$listen = '127.0.0.1:7531';
GetOptions('config=s' => \$conf, 'dry-run|n' => \$dry, 'quiet|q' => \$quiet,
           'provider=s' => \$only, 'help|h' => \$help,
           'listen=s' => \$listen, 'name=s' => \$cname, 'ctype=s' => \$ckind,
           'service=s' => \$cservice, 'notes=s' => \$cnotes,
           'enable' => sub { $cenable = 1 }, 'disable' => sub { $cenable = 0 },
           'no-auth' => \$no_auth,
          ) or usage(2);
usage(0) if $help;
my $cmd = shift @ARGV // usage(2);

# Second parse, for options that follow the SUBCOMMAND. require_order above
# stops at the first non-option — which is the subcommand itself — so without
# this `contact-add +1408... --name 'X'` never sees --name and the daemon is
# asked to create a nameless contact. Only done for the contact verbs: for
# `send`, everything after the recipient is deliberately message text and must
# not be parsed as options.
if ($cmd =~ /^contact|^service/) {
    local $SIG{__WARN__} = sub { warn $_[0] };
    Getopt::Long::Configure('permute');
    GetOptions('name=s' => \$cname, 'ctype=s' => \$ckind,
               'service=s' => \$cservice, 'notes=s' => \$cnotes,
               'listen=s' => \$listen, 'no-auth' => \$no_auth,
               'enable' => sub { $cenable = 1 }, 'disable' => sub { $cenable = 0 },
               'url=s' => \$svc{url}, 'account=s' => \$svc{account},
               'svckind=s' => \$svc{svckind}, 'direction=s' => \$svc{direction}, 'from=s' => \$svc{from_number},
               'forwards-to=s' => \$svc{forwards_to},
               'secret-name=s' => \$svc{secret_name}, 'status=s' => \$svc{status},
              ) or usage(2);
}

my $sms;
unless ($cmd =~ /^contact|^service/) {
    $sms = NetMgr::SMS->load(config => $conf, ($dry ? (dry_run => 1) : ()));
}
if ($only && $sms) {
    # Keep the named provider only, preserving its configured position so the
    # ordering semantics are identical to a full run.
    @{ $sms->{providers} } = grep { $_->{name} eq $only } @{ $sms->{providers} };
    die "net-sms: no provider named '$only' in " . $sms->{path} . "\n"
        unless @{ $sms->{providers} };
}

# ---- contacts (stored in the DB, replicated to every node) ----------
if ($cmd =~ /^contact|^service/) {
    require NetMgr::Client;
    my $cli = NetMgr::Client->new(listen => $listen) or die "net-sms: no daemon\n";
    # Writing a contact is a mutating verb, so a non-loopback connection has to
    # authenticate — the daemon's _chat_identity returns undef otherwise and the
    # OBSERVE comes back "not authorized". Loopback is implicitly trusted, so
    # skip the handshake there (and when --no-auth is given).
    my ($h) = NetMgr::Client::split_hostport($listen);
    my $loopback = defined $h && $h =~ /^(?:127\.\d+\.\d+\.\d+|::1|localhost)$/;
    if (!$loopback && !$no_auth && $cmd ne 'contacts' && $cmd ne 'services') {
        eval { $cli->auth() };
        die "net-sms: AUTH failed: $@" if $@;
    }
    $cli->hello(consumer => "net-sms.$$") unless $cli->{greeted};
    if ($cmd eq 'services') {
        my $rows = eval { $cli->snapshot(1, 'sms_services') } || [];
        eval { $cli->bye };
        unless (@$rows) { print "no services\n"; exit 0 }
        printf "%-12s %-6s %-4s %-16s %-22s %-9s %s
",
            'NAME','KIND','DIR','FROM','ACCOUNT','STATUS','SECRET';
        for my $r (sort { ($a->{name}//'') cmp ($b->{name}//'') } @$rows) {
            printf "%-12s %-6s %-4s %-16s %-22s %-9s %s
", $r->{name}//'?',
                $r->{kind}//'', $r->{direction}//'', $r->{from_number}//'', $r->{account}//'',
                $r->{status}//'', $r->{secret_name}//'-';
        }
        exit 0;
    }
    if ($cmd eq 'service-set') {
        my $n = shift @ARGV or die "net-sms: service-set needs a NAME
";
        my $r = $cli->observe(kind => 'sms_service', name => $n,
            (map { defined ${$svc{$_}} ? ($_ => ${$svc{$_}}) : () }
                 grep { ref $svc{$_} } keys %svc),
            (defined $cnotes  ? (notes   => $cnotes)  : ()),
            (defined $cenable ? (enabled => $cenable) : ()));
        eval { $cli->bye };
        die "net-sms: $r
" if !defined $r || $r =~ /^ERR/;
        print "ok
"; exit 0;
    }
    if ($cmd eq 'contacts') {
        my $rows = eval { $cli->snapshot(1, 'sms_contacts') } || [];
        eval { $cli->bye };
        unless (@$rows) { print "no contacts\n"; exit 0 }
        printf "%-17s %-22s %-9s %-12s %s\n", 'NUMBER','NAME','KIND','SERVICE','ON';
        for my $r (sort { ($a->{name}//'') cmp ($b->{name}//'') } @$rows) {
            printf "%-17s %-22s %-9s %-12s %s\n", $r->{number}//'?', $r->{name}//'',
                $r->{kind}//'', $r->{service}//'',
                (defined $r->{enabled} && !$r->{enabled} ? 'no' : 'yes');
        }
        exit 0;
    }
    my $num = shift @ARGV or die "net-sms: $cmd needs a number\n";
    my $r;
    if ($cmd eq 'contact-del') {
        $r = $cli->observe(kind => 'sms_contact_delete', number => $num);
    }
    else {   # contact-add / contact-set
        # A contact's kind travels as ctype: the protocol's own `kind` selects
        # the verb, so sending kind=mobile would re-dispatch the OBSERVE.
        $r = $cli->observe(kind => 'sms_contact', number => $num,
            (defined $cname   ? (name    => $cname)   : ()),
            (defined $ckind   ? (ctype   => $ckind)   : ()),
            (defined $cservice? (service => $cservice): ()),
            (defined $cnotes  ? (notes   => $cnotes)  : ()),
            (defined $cenable ? (enabled => $cenable) : ()));
    }
    eval { $cli->bye };
    die "net-sms: $r\n" if !defined $r || $r =~ /^ERR/;
    print "ok\n";
    exit 0;
}

if ($cmd eq 'providers') {
    my $rows = $sms->status;
    unless (@$rows) { print "no providers configured in $sms->{path}\n"; exit 1 }
    printf "%-14s %-8s %-4s %-5s %s\n", 'PROVIDER', 'TYPE', 'NET', 'READY', 'WHY NOT';
    for my $r (@$rows) {
        printf "%-14s %-8s %-4s %-5s %s\n", $r->{name}, $r->{type},
            ($r->{needs_net} ? 'yes' : 'no'), ($r->{ok} ? 'yes' : 'NO'), $r->{why};
    }
    printf "\ninternet reachable: %s\n", $sms->have_net ? 'yes' : 'NO';
    exit 0;
}

my $to = shift @ARGV or usage(2);
my $text = $cmd eq 'test'
    ? 'net-sms test from ' . hostname()
    : join(' ', @ARGV);
usage(2) if $cmd ne 'send' && $cmd ne 'test';
die "net-sms: empty message\n" unless length $text;

my ($ok, $via, $log) = $sms->send($to, $text);
unless ($quiet) { print "  $_\n" for @$log }
if ($ok) {
    print +($dry ? "would send via $via\n" : "sent via $via\n");
    exit 0;
}
print "NOT SENT - no provider succeeded\n";
exit 1;

sub usage {
    my ($rc) = @_;
    print <<'USAGE';
net-sms [--config F] [--dry-run] [--quiet] [--provider N] COMMAND

  send TO MESSAGE...   send MESSAGE to TO, trying providers in configured order
  test TO              send a short test message
  providers            show each provider, whether it is ready, and why not

  contacts                         list notification contacts (from the DB)
  contact-add NUMBER --name N [--ctype mobile|voip|landline]
                              [--service numberbarn|gvoice|...] [--notes '..']
  contact-set NUMBER [--name N] [--enable|--disable] [...]
  contact-del NUMBER

Contacts live in the replicated sms_contacts table, not in sms.conf, so every
node has the list. A contact's kind is --ctype because the protocol's own
`kind` field selects the verb.

Exits 0 only when a provider accepted the message.
USAGE
    exit $rc;
}
