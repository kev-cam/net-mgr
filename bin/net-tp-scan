#!/usr/bin/perl
# net-tp-scan — discover TP-Link Kasa smart plugs/strips on the network,
# query each for its outlet aliases + on/off state, and update net-mgr's
# DB:
#
#   * wifi_sockets gets one row per outlet (controller, outlet#,
#     name, state, controller_type).
#   * friendly_names gets the alias for single plugs (skipping
#     placeholder names like "TP-LINK_Power Strip_42").
#
# Replaces the older /usr/local/bin/tp-scan, which only printed and
# numbered strips inconsistently. Output mirrors tp-scan's per-outlet
# layout, with [1] / [0] marking on/off:
#
#   pwrplug0     192.168.15.200  1+ psu [1]                          (HS110)
#   pwrstrip0    192.168.15.190  TP-LINK_Power Strip_0CBF            (HS300)
#                                  1: Patio Network         [0]
#                                  2: Patio DVD             [0]
#                                  3: Patio Computer        [0]
#                                  ...
#
# Two protocols, probed in order:
#   * legacy Kasa "abyss" (HS100/HS110/HS300/KP303) via hsx(1) -> hs100:
#     TCP 9999, XOR-obfuscated JSON, no authentication.
#   * Tapo (P300/P316-class) via a python-kasa CLI, asked for the
#     device's raw reply with --json. Authenticated: needs the TP-Link
#     account as 'email:password' in /etc/net-mgr/secrets/tapo. The CLI
#     is found via [tp_scan] kasa, else /opt/kasa-venv/bin/kasa, else
#     $PATH -- deliberately nothing under a home directory.

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(:config no_ignore_case bundling);
use JSON::PP qw(decode_json);
use MIME::Base64 qw(decode_base64);
use NetMgr::Config;
use NetMgr::Secret;
use NetMgr::DB;
use NetMgr::Client;

my $listen;
my $dry_run;
my $force;
my $filter = 'pwr(plug|strip)';
my $help;
GetOptions(
    'listen=s'  => \$listen,
    'dry-run|n' => \$dry_run,
    'force'     => \$force,
    'filter=s'  => \$filter,
    'help|h'    => \$help,
) or die "bad options\n";

if ($help) {
    print <<'EOT';
net-tp-scan — query TP-Link plugs and pin aliases / outlet state.

  net-tp-scan                  Auto: find pwr(plug|strip)*, scan, update DB.
  net-tp-scan IP [IP ...]      Just these IPs (skips DB candidate lookup).
  net-tp-scan --filter REGEX   Custom auto-find regex (against primary_name).
  net-tp-scan --dry-run        Print but don't write to the DB.
  net-tp-scan --force          Overwrite friendly_names (default skips them
                               if already set; wifi_sockets is always
                               refreshed since state changes over time).
EOT
    exit 0;
}

# Build candidate list -----------------------------------------------

my $cli = NetMgr::Client->new(listen => $listen);
$cli->hello(consumer => "net-tp-scan.$$");
my $machines  = $cli->snapshot(1, 'machines');
my $ifaces    = $cli->snapshot(2, 'interfaces');
my $addresses = $cli->snapshot(3, 'addresses', where => "family = 'v4'");
my $friendly  = $cli->snapshot(4, 'friendly_names');
$cli->bye;

my %friendly_by_id = map { $_->{machine_id} => $_->{name} } @$friendly;
my %iface_by_machine;
push @{ $iface_by_machine{$_->{machine_id}} }, $_
    for grep { defined $_->{machine_id} } @$ifaces;
my %addr_by_mac;
push @{ $addr_by_mac{$_->{mac}} }, $_->{addr} for @$addresses;
my %machine_by_id = map { $_->{id} => $_ } @$machines;

my %id_by_ip;
for my $a (@$addresses) {
    next unless $a->{mac} && $a->{addr};
    my @ifs = grep { $_->{mac} eq $a->{mac} } @$ifaces;
    next unless @ifs && defined $ifs[0]{machine_id};
    $id_by_ip{$a->{addr}} //= $ifs[0]{machine_id};
}

my @candidates;
if (@ARGV) {
    for my $ip (@ARGV) {
        my $id = $id_by_ip{$ip};
        my $name = $id ? $machine_by_id{$id}{primary_name} // '' : '';
        push @candidates, { id => $id, name => $name, ip => $ip };
    }
} else {
    my $re = qr/$filter/i;
    for my $m (@$machines) {
        next unless $m->{primary_name} && $m->{primary_name} =~ $re;
        my $ifs = $iface_by_machine{$m->{id}} or next;
        my $ip;
        for my $i (@$ifs) {
            for my $a (@{ $addr_by_mac{$i->{mac}} || [] }) {
                next unless $a =~ /^\d+\.\d+\.\d+\.\d+$/;
                $ip = $a;
                last;
            }
            last if $ip;
        }
        next unless $ip;
        push @candidates, { id => $m->{id}, name => $m->{primary_name}, ip => $ip };
    }
}

if (!@candidates) {
    print "no candidates (filter: $filter)\n";
    exit 0;
}

# Probe + write ------------------------------------------------------

my $db;
unless ($dry_run) {
    my $cfg = NetMgr::Config->load(
        $ENV{NET_MGR_CONF} // '/etc/net-mgr/config');
    my $mycnf = (-r "$ENV{HOME}/.my.cnf") ? "$ENV{HOME}/.my.cnf"
              : NetMgr::Config->mysql_defaults_file($cfg);
    $db = NetMgr::DB->new(
        defaults_file => $mycnf,
        section       => $cfg->{mysql}{section},
        db            => $cfg->{mysql}{db},
    );
    $db->connect;
}

my $devices = 0; my $outlets_total = 0; my $silent = 0;
for my $c (sort { $a->{name} cmp $b->{name} } @candidates) {
    my $r = probe($c->{ip});
    if (!$r) {
        printf "  %-12s %-15s no response\n", $c->{name}, $c->{ip};
        $silent++;
        next;
    }
    $devices++;
    my $model = $r->{model} // '';
    if ($r->{type} eq 'plug') {
        printf "  %-12s %-15s %-30s [%s]  (%s)\n",
            $c->{name}, $c->{ip}, $r->{alias},
            (defined $r->{state} ? $r->{state} : '?'),
            $model;
        $outlets_total++;
        next unless $c->{id};
        if (!$dry_run) {
            $db->upsert_wifi_socket(
                machine_id      => $c->{id}, outlet => 0,
                name            => $r->{alias},
                state           => $r->{state},
                controller_type => $model,
            );
            # Single-outlet alias is a good display name unless the
            # user already pinned one.
            if (length $r->{alias}
                && $r->{alias} !~ /^(Strip_\d+|TP-LINK_(?:Power|Smart Plug))/
                && ($force || !exists $friendly_by_id{$c->{id}}))
            {
                $db->upsert_friendly_name(
                    machine_id => $c->{id},
                    name       => $r->{alias},
                    notes      => "from net-tp-scan ($c->{ip})",
                );
            }
        }
    } else {
        printf "  %-12s %-15s %-30s      (%s, %d outlets)\n",
            $c->{name}, $c->{ip}, $r->{alias}, $model,
            scalar @{ $r->{outlets} };
        for my $o (@{ $r->{outlets} }) {
            printf "  %-12s %-15s %2d: %-26s [%s]\n",
                '', '', $o->{outlet}, $o->{name},
                (defined $o->{state} ? $o->{state} : '?');
            $outlets_total++;
            next unless $c->{id};
            if (!$dry_run) {
                $db->upsert_wifi_socket(
                    machine_id      => $c->{id},
                    outlet          => $o->{outlet},
                    name            => $o->{name},
                    state           => $o->{state},
                    controller_type => $model,
                );
            }
        }
        # Don't pin the strip's own alias as friendly_name when it's
        # the placeholder. The primary_name (pwrstrip0) is more useful.
    }
}
printf "\n%d device(s), %d outlet(s) recorded, %d no-response\n",
       $devices, $outlets_total, $silent;

# ---- helpers -------------------------------------------------------

# Returns either:
#   { type => 'plug',  model, alias, state }
#   { type => 'strip', model, alias, outlets => [{outlet, name, state}, ...] }
# Find a python-kasa CLI.
#
# This used to go through `hsx -tapo`, which did
#   chdir "$kdir/py-env/kasa" or die      # $kdir = /home/dkc
# — a venv inside one person's home directory. That directory no longer exists
# on any node, so the Tapo branch had been dead for as long as anyone had a
# Tapo device, failing silently into "no response". Nothing here depends on a
# home directory now: a system venv, an explicit config path, or $PATH.
#
# Order: [tp_scan] kasa in /etc/net-mgr/config wins, then the conventional
# system venv, then whatever is on $PATH.
my $_kasa;
sub kasa_bin {
    return $_kasa if defined $_kasa;
    my $cfg = eval { NetMgr::Config->load } || {};
    my @cand = grep { defined && length }
        ($cfg->{tp_scan}{kasa}, '/opt/kasa-venv/bin/kasa', '/usr/local/bin/kasa');
    for my $c (@cand) { return $_kasa = $c if -x $c }
    my $p = `sh -c 'command -v kasa' 2>/dev/null`;
    chomp $p;
    return $_kasa = (length $p ? $p : '');
}

# Tapo credentials. Unlike the legacy abyss protocol, which is unauthenticated,
# every Tapo device requires the TP-Link account email and password — they are
# never sent in clear, but they are what the KLAP auth hash is derived from.
# Stored as 'email:password' in /etc/net-mgr/secrets/tapo (mode 0600);
# NetMgr::Secret warns if the mode is looser than that.
my @_tapo_cred;
sub tapo_cred {
    return @_tapo_cred if @_tapo_cred;
    my ($u, $p, $err) = NetMgr::Secret::get_userpass('tapo');
    return @_tapo_cred = (undef, undef) if defined $err;
    return @_tapo_cred = ($u, $p);
}

# or undef on failure.
sub probe {
    my ($ip) = @_;

    # Try the JSON path first (hsx without -tapo execs hs100, which
    # speaks the abyss protocol used by HS100/HS110/HS300).
    my $out = `timeout 5 hsx \Q$ip\E info 2>/dev/null` // '';
    if (length $out) {
        my $j = eval { decode_json($out) };
        my $info = $j && $j->{system} && $j->{system}{get_sysinfo};
        if ($info) {
            my $alias = $info->{alias} // '';
            my $model = $info->{model} // '';
            $model =~ s/\(US\)$//;   # 'HS110(US)' → 'HS110'
            if ($info->{children} && ref $info->{children} eq 'ARRAY') {
                my @outlets;
                my $i = 1;
                for my $c (@{ $info->{children} }) {
                    push @outlets, {
                        outlet => $i++,
                        name   => $c->{alias} // "outlet$i",
                        state  => (defined $c->{state} ? $c->{state} + 0 : undef),
                    };
                }
                return {
                    type    => 'strip', model => $model,
                    alias   => $alias,  outlets => \@outlets,
                };
            }
            return {
                type  => 'plug',
                model => $model,
                alias => $alias,
                state => (defined $info->{relay_state}
                         ? $info->{relay_state} + 0 : undef),
            };
        }
    }

    # Tapo (KLAP / securePassthrough). Asks python-kasa for the device's RAW
    # response with --json and reads that, rather than scraping the CLI's
    # human output as the old hsx path did — the text layout is presentation
    # and changes between releases; the JSON is the device's own reply.
    my $bin = kasa_bin();
    return undef unless length $bin;
    my ($user, $pass) = tapo_cred();
    return undef unless defined $user;

    $out = `timeout 20 \Q$bin\E --host \Q$ip\E --username \Q$user\E --password \Q$pass\E --json state 2>/dev/null` // '';
    return undef unless length $out;
    my $j = eval { decode_json($out) } or return undef;

    my $info  = $j->{get_device_info} || {};
    my $model = $info->{model} // '';
    # Nicknames are base64 on the wire.
    my $b64 = sub {
        my ($v) = @_;
        return '' unless defined $v && length $v;
        my $d = eval { decode_base64($v) };
        return (defined $d && length $d) ? $d : $v;
    };
    my $alias = $b64->($info->{nickname});

    my $kids = $j->{get_child_device_list}{child_device_list};
    if (!$kids || !@$kids) {
        # Single plug: device_on is the whole story.
        my $state = defined $info->{device_on} ? ($info->{device_on} ? 1 : 0) : undef;
        return { type => 'plug', model => $model, alias => $alias, state => $state };
    }

    # Multi-outlet strip. 'position' is the device's own 1-based slot number
    # and matches the numbering this tool already stores in wifi_sockets, so
    # use it rather than the array index — a strip that reports its children
    # out of order would otherwise be silently renumbered.
    my @outlets;
    for my $c (@$kids) {
        my $pos = $c->{position};
        $pos = scalar(@outlets) + 1 unless defined $pos && $pos =~ /^\d+$/;
        push @outlets, {
            outlet => $pos + 0,
            name   => $b64->($c->{nickname}),
            state  => (defined $c->{device_on} ? ($c->{device_on} ? 1 : 0) : undef),
        };
    }
    @outlets = sort { $a->{outlet} <=> $b->{outlet} } @outlets;
    return { type => 'strip', model => $model, alias => $alias, outlets => \@outlets };
}
