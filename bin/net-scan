#!/usr/bin/perl
# net-scan — list known hosts (interfaces + addresses + ports + names).
# (Replaces the legacy /usr/local/bin/scan-network. The active scanning
# producer that nmap-sweeps the network is bin/net-discover.)
#
#   net-scan               # snapshot known hosts from the daemon
#   net-scan -quick        # same (alias)
#   net-scan --discover    # TRIGGER discover, then snapshot
#   net-scan --listen H:P  # override manager address

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(:config no_ignore_case bundling pass_through);
use NetMgr::Client;

my $listen;
my $quick;
my $discover;
my $help;
GetOptions(
    'listen=s' => \$listen,
    'quick'    => \$quick,
    'discover' => \$discover,
    'help|h'   => \$help,
) or usage("bad options");
usage() if $help;

# Kept next to GetOptions deliberately: a usage block that lives far from the
# option list is the one that goes stale. Note pass_through is set above, so an
# unknown option is NOT an error here — it falls through to the daemon address
# check and fails later with something less obvious. --help at least gives the
# reader the real list.
sub usage {
    my ($msg) = @_;
    my $fh = $msg ? *STDERR : *STDOUT;
    print $fh "net-scan: $msg\n\n" if $msg;
    print $fh <<'USAGE';
net-scan — list known hosts (interfaces + addresses + ports + names).

usage:
  net-scan                    snapshot known hosts from the daemon
  net-scan --quick            same (alias; -quick also accepted)
  net-scan --discover         TRIGGER a discover sweep first, then snapshot
  net-scan --listen HOST:PORT talk to a specific manager (default: config)
  net-scan --help             this text

notes:
  Reads what the daemon already knows; it does not scan by itself.
  --discover asks the daemon to run its nmap sweep first, which takes
  time and touches the network — the plain form does neither.
  The active scanning producer is net-discover.
USAGE
    exit($msg ? 2 : 0);
}

my $cli = NetMgr::Client->new(listen => $listen);
$cli->hello(consumer => "net-scan.$$");

if ($discover) {
    my $r = $cli->trigger("discover", wait => 1);
    print STDERR "TRIGGER discover: $r\n" if $r;
}

# Pull interfaces, addresses, ports, hostnames; build a per-host view.
my $ifaces = $cli->snapshot(1, 'interfaces');
my $addrs  = $cli->snapshot(2, 'addresses', where => "family = 'v4'");
my $ports  = $cli->snapshot(3, 'ports');
my $hosts  = $cli->snapshot(4, 'hostnames');

my %iface_by_mac = map { $_->{mac} => $_ } @$ifaces;
my %ips_by_mac;   push @{ $ips_by_mac{$_->{mac}} }, $_->{addr} for @$addrs;
my %ports_by_mac; push @{ $ports_by_mac{$_->{mac}} }, $_       for @$ports;
my %hosts_by_mid; push @{ $hosts_by_mid{$_->{machine_id}} }, $_->{name}
                                                            for @$hosts;

# Print one line per (interface, ip) pair.
my @rows;
for my $mac (sort keys %iface_by_mac) {
    my $iface = $iface_by_mac{$mac};
    my @ips   = @{ $ips_by_mac{$mac} || ['?'] };
    my @hns   = ($iface->{machine_id}
                 ? @{ $hosts_by_mid{$iface->{machine_id}} || [] } : ());
    my $hn    = $hns[0] // '';
    my @ps    = sort { $a->{port} <=> $b->{port} } @{ $ports_by_mac{$mac} || [] };
    my $ports = join(',', port_labels(@ps));
    for my $ip (sort @ips) {
        push @rows, [ $ip, $mac, $hn, $iface->{vendor} // '', $ports,
                      ($iface->{online} ? 'up' : 'off') ];
    }
}

# IPv4 sort by numeric octets
@rows = sort { _ip_key($a->[0]) cmp _ip_key($b->[0]) } @rows;
my $fmt = "%-15s %-17s %-22s %-20s %s\n";
printf $fmt, qw(IP MAC HOST VENDOR PORTS);
for my $r (@rows) {
    printf $fmt, @{$r}[0..4];
}

$cli->bye;

# Render port rows as service names (nmap-tagged service > /etc/services
# > numeric fallback). Dedupes labels so tcp/22+udp/22 don't both appear
# as "ssh"; sticks with the numeric port if nothing else resolves.
sub port_labels {
    my @ps = @_;
    my %seen;
    my @out;
    for my $p (@ps) {
        my $label = $p->{service};
        if (!defined $label || !length $label) {
            my $proto = $p->{proto} // 'tcp';
            $label = getservbyport($p->{port}, $proto) // $p->{port};
        }
        next if $seen{$label}++;
        push @out, $label;
    }
    return @out;
}

sub _ip_key {
    my $ip = shift;
    return '999.999.999.999' if $ip !~ /^\d+\.\d+\.\d+\.\d+$/;
    return sprintf "%03d.%03d.%03d.%03d", split /\./, $ip;
}
