#!/usr/bin/perl
# net-gen-hosts — regenerate /etc/hosts.dhcp from net-mgr's DHCP data, and
# assemble /etc/hosts (and any other target) from a list of fragments.
#
# The old regime rebuilt /etc/hosts whenever DHCP changed. net-mgr replaced the
# DNS half of that but never touched hosts files, so a stale line in /etc/hosts
# outranks everything the fleet knows: `ping wc12` answered 192.168.15.229 for
# two weeks while DNS correctly said .132, because the system resolver reads
# /etc/hosts first and nothing had rewritten it since the camera moved.
#
# This writes only the DHCP-derived fragment and then concatenates fragments in
# the order the config names them, so hand-maintained entries stay hand-
# maintained and live in their own file:
#
#     [hosts]
#     /etc/hosts = /etc/hosts.grfx,/etc/hosts.dhcp
#
# The key is the file to build; the value lists the parts. Several targets may
# be listed. A part that does not exist is skipped with a warning rather than
# aborting the run - a missing hand-file must not cost you the DHCP half.
#
# Usage:
#   net-gen-hosts                      # write the fragment, then assemble
#   net-gen-hosts --no-assemble        # fragment only
#   net-gen-hosts --dry-run            # print what would change, write nothing
#   net-gen-hosts --dhcp-file PATH     # fragment path (default /etc/hosts.dhcp)
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long;
use File::Temp ();
use NetMgr::Config;
use NetMgr::Client;

my ($server, $dry, $force, $help);
my $dhcp_file = '/etc/hosts.dhcp';
my $assemble  = 1;
GetOptions(
    'server=s'    => \$server,
    'dhcp-file=s' => \$dhcp_file,
    'assemble!'   => \$assemble,
    'dry-run'     => \$dry,
    'force'       => \$force,
    'help|h'      => \$help,
) or die "net-gen-hosts: bad options (try --help)\n";

if ($help) {
    print <<'USAGE';
net-gen-hosts — rebuild the DHCP hosts fragment and assemble /etc/hosts

  --dhcp-file PATH   where to write the DHCP fragment (default /etc/hosts.dhcp)
  --no-assemble      write the fragment only; do not rebuild any target
  --dry-run          report what would change; write nothing
  --force            assemble even if the result has no loopback entry
  --server H:P       net-mgr to read from (default: local/discovered)

Targets come from the [hosts] section of /etc/net-mgr/config, where the KEY is
the file to build and the VALUE is a comma-separated list of fragments:

  [hosts]
  /etc/hosts = /etc/hosts.grfx,/etc/hosts.dhcp
USAGE
    exit 0;
}

my $conf_path = $ENV{NET_MGR_CONF} // '/etc/net-mgr/config';
my $cfg = -r $conf_path ? eval { NetMgr::Config->load($conf_path) } : undef;
$cfg ||= {};

# Domain, resolved the way net-gen-dnsmasq resolves it so the FQDN column here
# matches the one DNS serves.
my $domain = '';
for my $sect (qw(dhcp dns cluster)) {
    next unless ref $cfg->{$sect} eq 'HASH';
    my $d = $cfg->{$sect}{domain};
    next unless defined $d;
    $d =~ s/^\s+|\s+$//g;
    next unless length $d;
    $domain = $d;
    last;
}
$domain = 'grfx.com' unless length $domain;

# The daemon passes its own address in NET_MGR_LISTEN when it runs a producer,
# so a fan-out on a follower reads that node's daemon rather than discovering.
$server //= $ENV{NET_MGR_LISTEN};
my $listen = $server;
$listen = NetMgr::Config->resolve_server($server) if defined $server && $server !~ /:/;
my $cli = defined $listen
    ? NetMgr::Client->new(listen => $listen, timeout => 10)
    : NetMgr::Client->new(discover => 1, consumer => "net-gen-hosts.$$", timeout => 10);
$cli->hello(consumer => "net-gen-hosts.$$");

# Reservations are the authority: they are what the operator asked for, and what
# dnsmasq is told to serve. Leases fill in hosts that have no reservation, so a
# dynamic machine still resolves - but never overrides a reservation, or a
# just-moved host would keep answering on the address it is being moved off.
my $resv   = eval { $cli->snapshot(1, 'dhcp_reservations') } || [];
my $leases = eval { $cli->snapshot(2, 'dhcp_leases') }       || [];

my (%by_ip, %seen_name);
sub add_entry {
    my ($ip, $name, $why) = @_;
    return unless defined $ip && $ip =~ /\A\d+\.\d+\.\d+\.\d+\z/;
    return unless defined $name && length $name;
    $name =~ s/^\s+|\s+$//g;
    $name =~ s/\.\Q$domain\E\.?\z//i;      # store the label; the FQDN is derived
    return unless length $name;
    return if $seen_name{lc $name}++;      # first writer wins: reservations
    $by_ip{$ip} = { name => $name, why => $why };
}
add_entry($_->{ip}, $_->{name}, 'reservation') for @$resv;
add_entry($_->{ip}, $_->{hostname}, 'lease')   for @$leases;

my @lines;
push @lines, "# Generated by net-gen-hosts - DO NOT EDIT.";
push @lines, "# Hand-maintained entries belong in their own fragment; see";
push @lines, "# the [hosts] section of /etc/net-mgr/config.";
for my $ip (sort { sprintf('%03d%03d%03d%03d', split /\./, $a)
                cmp sprintf('%03d%03d%03d%03d', split /\./, $b) } keys %by_ip) {
    my $e = $by_ip{$ip};
    push @lines, sprintf("%-16s %s %s.%s", $ip, $e->{name}, $e->{name}, $domain);
}
my $frag = join("\n", @lines) . "\n";

sub write_atomic {
    my ($path, $content) = @_;
    my ($dir) = $path =~ m{^(.*)/[^/]+$};
    $dir ||= '.';
    my $tmp = File::Temp->new(DIR => $dir, UNLINK => 0);
    print {$tmp} $content or die "net-gen-hosts: write $path: $!\n";
    close $tmp;
    chmod 0644, $tmp->filename;
    rename $tmp->filename, $path or die "net-gen-hosts: rename onto $path: $!\n";
}

my $existing = '';
if (open my $fh, '<', $dhcp_file) { local $/; $existing = <$fh>; close $fh }
if ($existing eq $frag) {
    print "net-gen-hosts: $dhcp_file unchanged (", scalar(keys %by_ip), " hosts)\n";
} elsif ($dry) {
    print "net-gen-hosts: would write $dhcp_file (", scalar(keys %by_ip), " hosts)\n";
} else {
    write_atomic($dhcp_file, $frag);
    print "net-gen-hosts: wrote $dhcp_file (", scalar(keys %by_ip), " hosts)\n";
}

exit 0 unless $assemble;

my $targets = (ref $cfg->{hosts} eq 'HASH') ? $cfg->{hosts} : {};
unless (%$targets) {
    print "net-gen-hosts: no [hosts] targets configured; fragment only\n";
    exit 0;
}

for my $target (sort keys %$targets) {
    my @parts = grep { length } map { s/^\s+|\s+$//gr } split /,/, $targets->{$target};
    unless (@parts) {
        warn "net-gen-hosts: $target has no fragments listed - skipped\n";
        next;
    }
    my ($body, $missing, $used) = ('', 0, 0);
    for my $p (@parts) {
        if (open my $fh, '<', $p) {
            local $/;
            my $c = <$fh>;
            close $fh;
            $c = '' unless defined $c;
            $c .= "\n" unless $c eq '' || $c =~ /\n\z/;
            $body .= $c;
            $used++;
        } else {
            warn "net-gen-hosts: $target: fragment $p missing - skipped\n";
            $missing++;
        }
    }
    unless ($used) {
        warn "net-gen-hosts: $target: no fragments readable - REFUSING to write\n";
        next;
    }
    # A hosts file with no loopback entry breaks name resolution for the host
    # itself, and sudo/systemd/ssh all notice. Refuse rather than produce one:
    # the likely cause is a mis-listed fragment, and the blast radius is the
    # whole machine.
    unless ($body =~ /^\s*(?:127\.0\.0\.1|::1)\s/m || $force) {
        warn "net-gen-hosts: $target: assembled content has no loopback entry - "
           . "REFUSING (use --force to override)\n";
        next;
    }
    my $head = "# Assembled by net-gen-hosts from: " . join(', ', @parts) . "\n"
             . "# DO NOT EDIT - edit the fragments instead.\n";
    my $out  = $head . $body;

    my $cur = '';
    if (open my $fh, '<', $target) { local $/; $cur = <$fh>; close $fh; $cur //= '' }
    if ($cur eq $out) {
        print "net-gen-hosts: $target unchanged\n";
        next;
    }
    if ($dry) {
        printf "net-gen-hosts: would write %s (%d fragment(s), %d missing)\n",
               $target, $used, $missing;
        next;
    }
    # Keep one copy of whatever was there before this tool first touched it.
    my $bak = "$target.netmgr-backup";
    if (length $cur && !-e $bak) {
        if (open my $b, '>', $bak) { print {$b} $cur; close $b;
            print "net-gen-hosts: kept the previous $target as $bak\n" }
    }
    write_atomic($target, $out);
    printf "net-gen-hosts: wrote %s (%d fragment(s)%s)\n",
           $target, $used, ($missing ? ", $missing missing" : '');
}
exit 0;
