#!/usr/bin/perl
# net-onvif — find a camera's ONVIF / RTSP services even on non-standard ports.
#
# Cheap IP cameras (and some firmwares in a half-provisioned state) don't always
# put ONVIF on 8899 or RTSP on 554 — they wander to odd high ports. This tool
# stops guessing: it discovers EVERY open TCP port on the target, then actively
# SPEAKS each protocol to each open port and reports which ones answer as ONVIF,
# RTSP, or a plain camera web UI.
#
#   net-onvif <name|ip> [options]
#
# Per open port it tries, in order:
#   - ONVIF : POST a GetSystemDateAndTime SOAP to /onvif/device_service (and a
#             few common paths). That verb needs no auth per the ONVIF spec, so a
#             real ONVIF endpoint answers with a SOAP body naming onvif.org. A
#             SOAP *fault* still proves a SOAP/ONVIF endpoint (auth-gated).
#   - RTSP  : OPTIONS rtsp://ip:port/ — a real RTSP server replies "RTSP/1.0 200"
#             and lists its Public: methods (DESCRIBE/SETUP/PLAY…).
#   - HTTP  : GET / — captures Server: and WWW-Authenticate realm, which usually
#             name the camera firmware (uc-httpd, GoAhead, Boa, Hipcam, webs…).
#   34567/37777 are flagged as XM/Sofia / Dahua DVRIP (proprietary, app-only).
#
# Options:
#   --ports LIST   probe only these ports (e.g. 80,554,8000-8100); skips scan
#   --fast         discover with a wide camera/ONVIF port SET, not all 65535
#   --full         force an all-ports (-p-) scan even in --ports/fast defaults
#   --timeout SEC  per-probe connect/read timeout (default 3)
#   --user U --pass P   credentials for ONVIF auth and for the printed RTSP
#                       URLs (default admin / blank). These are now used to
#                       AUTHENTICATE (GetProfiles/GetStreamUri are auth-gated),
#                       not merely echoed into the URL.
#   --pass-file FILE    read the password from FILE (first line) instead
#   --ask               prompt for it on the terminal, with echo off
#                       (or set NET_ONVIF_PASS in the environment)
#                       — any of these keeps it out of ps and shell history
#   --listen H:P   net-mgr daemon for name resolution (passed to net-lookup)
#   -v             verbose: dump the raw protocol responses
#
# Runs best from a host ON the camera's subnet — a router between you and the
# camera can RST camera ports and hide them. Uses nmap for fast full-range
# discovery when present; falls back to a pure-Perl scan of a wide port set.
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(:config no_ignore_case bundling);
use IO::Socket::INET;
use Digest::SHA  qw(sha1);
use MIME::Base64 qw(encode_base64);
use IO::Select;

my %opt = (timeout => 2, user => 'admin', pass => '');
GetOptions(\%opt, 'ports=s', 'fast', 'full', 'timeout=i',
           'user=s', 'pass=s', 'pass-file=s', 'ask', 'listen=s',
           'ptz', 'ptz-speed=f', 'ptz-dwell=f',
           'sample', 'uri=s', 'out=s', 'show!', 'ffmpeg=s',
           'verbose|v', 'help|h')
    or usage(2);
usage(0) if $opt{help};

# Where the password comes from, most explicit first.
#
# --pass is kept because it is convenient, but it puts the credential in `ps`
# output and in shell history, which mattered little when these creds were only
# printed into a URL and matters now that they actually authenticate. The other
# three routes exist so there is a way not to do that.
if (!defined $opt{pass} || $opt{pass} eq '') {
    if (defined $opt{'pass-file'}) {
        open my $fh, '<', $opt{'pass-file'}
            or die "net-onvif: cannot read $opt{'pass-file'}: $!\n";
        my $p = <$fh>;
        close $fh;
        $p = '' unless defined $p;
        chomp $p;                     # a trailing newline is not part of it
        $opt{pass} = $p;
    } elsif ($opt{ask}) {
        print STDERR "password for $opt{user}: ";
        my $echo_off = system('stty -echo 2>/dev/null') == 0;
        my $p = <STDIN>;
        system('stty echo 2>/dev/null') if $echo_off;
        print STDERR "\n";
        $p = '' unless defined $p;
        chomp $p;
        $opt{pass} = $p;
    } elsif (defined $ENV{NET_ONVIF_PASS}) {
        $opt{pass} = $ENV{NET_ONVIF_PASS};
    }
}
# --uri needs no target: the URI already names the host. Everything else
# does, so the requirement stays for every other mode.
my $target = shift @ARGV;
usage(2) unless (defined $target && length $target)
              || (defined $opt{uri} && length $opt{uri});

# A broad set of ports these cameras are known to wander onto — used for --fast
# and as the pure-Perl fallback when nmap is absent.
my @CAMERA_PORTS = (
    21,23,37,80,81,82,83,88,443,554,555,587,700,1024,1025,1935,2000,2020,3702,
    5000,5353,5540,5541,5542,5543,5544,5545,6036,6668,7001,7080,7443,
    8000,8001,8008,8009,8010,8080,8081,8082,
    8090,8091,8181,8200,8443,8500,8554,8555,8600,8800,8880,8888,8899,8999,9000,
    9001,9002,9010,9080,9088,9090,9100,9200,9527,9999,10000,10001,10080,10554,
    11554,12345,18080,20000,34567,34599,37777,37778,49152,49153,50000,55555,
);

# ONVIF GetSystemDateAndTime — an unauthenticated verb per the ONVIF spec, so a
# live endpoint answers with a SOAP body naming onvif.org. Declared here (before
# the main flow) so onvif_check() sees it — a `my` assigned lower in the file
# runs after the probing loop and would be undef at call time.
my $ONVIF_SOAP =
  '<?xml version="1.0" encoding="UTF-8"?>'
. '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope">'
. '<s:Body xmlns:tds="http://www.onvif.org/ver10/device/wsdl">'
. '<tds:GetSystemDateAndTime/></s:Body></s:Envelope>';

# ---------------------------------------------------------------------------
# --uri: test one URI directly and stop. Discovery is the slow part of this
# tool and is pointless when the operator already has the URI in hand - this is
# the "I have this from VLC, why does my NVR hate it" path.
if (defined $opt{uri} && length $opt{uri}) {
    my $ok = report_rtsp('given', $opt{uri}, $opt{user}, $opt{pass});
    if ($opt{sample}) {
        my $dest = $opt{out} || (($ENV{TMPDIR} || '/tmp') . "/net-onvif-frame.jpg");
        my $err  = ffmpeg_grab($opt{uri}, $dest, $opt{ffmpeg});
        if ($err) {
            print "  frame: ffmpeg $err\n";
        } else {
            printf "  frame: %s\n", $dest;
            my $v = (defined $opt{show} && !$opt{show}) ? undef : show_file($dest);
            printf "         opened with %s\n", $v if $v;
        }
    }
    exit($ok ? 0 : 1);
}
my $ip = resolve_target($target);
print "== net-onvif: probing $target ($ip) ==\n";

my @ports = @{ $opt{ports} ? [expand_ports($opt{ports})] : discover_ports($ip) };
unless (@ports) {
    print "no open TCP ports found on $ip"
        . ($opt{fast} ? " (scanned the camera port set; try without --fast for all 65535)" : "")
        . ".\n";
    exit 1;
}
printf "open TCP ports: %s\n\n", join(', ', @ports);

my @onvif_hits;
my @rtsp_ports;
my $found_uri = 0;
printf "%-7s  %-9s  %-9s  %s\n", 'PORT', 'ONVIF', 'RTSP', 'HTTP / notes';
printf "%-7s  %-9s  %-9s  %s\n", '-------','---------','---------','------------';
for my $port (@ports) {
    my ($onvif, $opath, $odet) = onvif_check($ip, $port);
    my ($rtsp, $rmeth)         = rtsp_options($ip, $port);
    my ($hstat, $hserver, $hrealm) = http_probe($ip, $port);

    my $onvif_col = $onvif == 2 ? 'YES' : $onvif == 1 ? 'soap?' : '-';
    my $rtsp_col  = $rtsp ? 'YES' : '-';
    my @notes;
    push @notes, "HTTP $hstat" . (defined $hserver && length $hserver ? " [$hserver]" : '')
        if defined $hstat;
    push @notes, "realm=\"$hrealm\"" if defined $hrealm && length $hrealm;
    push @notes, "XM/Dahua DVRIP (proprietary)" if $port == 34567 || $port =~ /^3777[78]$/;
    push @notes, $rmeth if $rtsp && $rmeth;
    push @notes, $odet  if $onvif && $odet;

    printf "%-7s  %-9s  %-9s  %s\n", $port, $onvif_col, $rtsp_col, join(' | ', @notes);
    push @onvif_hits, [$port, $opath] if $onvif == 2;
    push @rtsp_ports, $port if $rtsp;
}

# UDP WS-Discovery (unicast) — a camera may announce its service URL directly.
my $xaddr = ws_discovery($ip);

print "\n";
# --ptz takes over as soon as an ONVIF endpoint is known: steering is what the
# operator asked for, and printing the stream table first would scroll it away.
if ($opt{ptz}) {
    unless (@onvif_hits) {
        print "PTZ needs ONVIF, and no endpoint answered on the probed ports.\n";
        print "  Try --ports with the camera's ONVIF port (often 8899 or 8000),\n";
        print "  or --fast to sweep the camera port set.\n";
        exit 1;
    }
    my ($pport, $ppath) = @{ $onvif_hits[0] };
    exit ptz_drive($ip, $pport, $ppath, $opt{user}, $opt{pass},
                   ($opt{'ptz-speed'} // 0.5), ($opt{'ptz-dwell'} // 0.35));
}

if (@onvif_hits) {
    for my $h (@onvif_hits) {
        my ($port, $path) = @$h;
        printf "ONVIF service: http://%s:%s%s\n", $ip, $port, $path;
        my ($uris, $why) = onvif_stream_uris($ip, $port, $path, $opt{user}, $opt{pass});
        if (@$uris) {
            $found_uri = 1;
            for my $u (@$uris) {
                my ($nm, $tok, $uri) = @$u;
                printf "  RTSP [%s]: %s\n", $nm, with_creds($uri, $opt{user}, $opt{pass});
                printf "        (as published, no credentials: %s)\n", $uri
                    if defined $opt{user} && length $opt{user};
            }
            if ($opt{sample}) {
                my $n = 0;
                for my $u (@$uris) {
                    my ($nm, undef, $uri) = @$u;
                    # Label with the PROFILE name rather than stream0/stream1: the
                    # profiles are listed just above with their URIs, so naming them
                    # here is what lets a reader tie a result to a URL instead of
                    # counting lines.
                    report_rtsp($nm, $uri, $opt{user}, $opt{pass});
                    if ($n == 0) {
                        my $dest = $opt{out} || (($ENV{TMPDIR} || '/tmp') . "/net-onvif-$ip.jpg");
                        # ffmpeg first: a decoded frame proves transport AND codec.
                        # The ONVIF snapshot is the fallback because it proves only
                        # that the camera can render a JPEG - a different service,
                        # which can work while RTSP does not.
                        my $err = ffmpeg_grab(with_creds($uri, $opt{user}, $opt{pass}),
                                              $dest, $opt{ffmpeg});
                        if (!$err) {
                            printf "  frame: %s" . chr(10) . "         from %s (ffmpeg: RTSP confirmed end to end)" . chr(10), $dest, $uri;
                        } else {
                            printf "  frame: ffmpeg %s\n", $err;
                            my ($snaps) = onvif_snapshot_uris($ip, $port, $path,
                                                              $opt{user}, $opt{pass});
                            if (@$snaps) {
                                printf "  snapshot URI: %s
", $snaps->[0][1];
                                my $serr = fetch_snapshot($snaps->[0][1], $opt{user},
                                                          $opt{pass}, $dest);
                                if ($serr) { printf "  snapshot: %s\n", $serr; $dest = undef }
                                else       { printf "  frame: %s" . chr(10) . "         from %s (ONVIF snapshot, NOT the RTSP stream)" . chr(10), $dest, $snaps->[0][1] }
                            } else {
                                print "  snapshot: camera offers no GetSnapshotUri\n";
                                $dest = undef;
                            }
                        }
                        if (defined $dest && -s $dest
                            && !(defined $opt{show} && !$opt{show})) {
                            my $v = show_file($dest);
                            printf "         opened with %s\n", $v if $v;
                        }
                    }
                    $n++;
                }
            }
        } else {
            printf "  no stream URI: %s\n", $why // 'GetProfiles returned none';
            # Never echo the password. --pass-file and --ask exist to keep it
            # out of ps and shell history; printing it here would put it in
            # terminal scrollback and any captured output instead, which is no
            # better. Say whether one was supplied, not what it was.
            printf "  creds tried: user=%s, password %s — set --user and one of "
                 . "--pass/--pass-file/--ask if the camera differs\n",
                   $opt{user},
                   ($opt{pass} ne '' ? 'supplied (' . length($opt{pass}) . ' chars)' : 'BLANK');
        }
    }
} elsif ($xaddr) {
    print "ONVIF (via WS-Discovery): $xaddr\n";
} else {
    print "No ONVIF responder on any open port.\n";
    print "  (If the only open port is 53/dnsmasq and nothing else, the camera is\n";
    print "   likely in setup/SoftAP mode — its service stack isn't running yet.)\n";
}
# RTSP is answering but ONVIF could not tell us the path. Print the base URL so
# there is something to work with, and be explicit that the path is unknown —
# a bare rtsp://host:port/ that a player rejects otherwise looks like a
# credentials problem rather than a missing path.
if (!$found_uri && @rtsp_ports) {
    print "\n";
    for my $p (@rtsp_ports) {
        printf "RTSP server: %s\n",
            with_creds("rtsp://$ip:$p/", $opt{user}, $opt{pass});
    }
    print "  stream path unknown — ONVIF did not answer GetStreamUri.\n"
        . "  Try -v to see the SOAP, or --user/--pass if credentials differ.\n";
}
exit(@onvif_hits || $xaddr || @rtsp_ports ? 0 : 1);

# ---- target resolution ----------------------------------------------------
sub resolve_target {
    my ($t) = @_;
    return $t if $t =~ /^\d{1,3}(?:\.\d{1,3}){3}$/;
    my $bin = (-x "$FindBin::Bin/net-lookup") ? "$FindBin::Bin/net-lookup" : 'net-lookup';
    my @cmd = ($bin, '--family', 'v4',
               ($opt{listen} ? ('--listen', $opt{listen}) : ()), "=$t");
    my $out = '';
    if (open my $fh, '-|', @cmd) { local $/; $out = <$fh> // ''; close $fh; }
    my ($found) = $out =~ /(\d{1,3}(?:\.\d{1,3}){3})/;
    die "net-onvif: cannot resolve '$t' to an IP (via net-lookup)\n" unless $found;
    return $found;
}

# ---- port discovery -------------------------------------------------------
sub expand_ports {
    my ($spec) = @_;
    my %seen;
    for my $tok (split /[,\s]+/, $spec) {
        if ($tok =~ /^(\d+)-(\d+)$/) { $seen{$_} = 1 for $1 .. $2 }
        elsif ($tok =~ /^\d+$/)      { $seen{$tok} = 1 }
    }
    return sort { $a <=> $b } keys %seen;
}

sub have_nmap { my $p = `sh -c 'command -v nmap' 2>/dev/null`; return $p =~ /\S/ }

sub discover_ports {
    my ($host) = @_;
    if (have_nmap()) {
        my @spec = $opt{fast} && !$opt{full}
                 ? ('-p', join(',', @CAMERA_PORTS))
                 : ('-p-');            # every TCP port — the point of this tool
        print "scanning "
            . ($opt{fast} && !$opt{full} ? scalar(@CAMERA_PORTS) . " camera ports" : "all 65535 TCP ports")
            . " on $host (nmap)...\n";
        my @cmd = ('nmap', '-Pn', '-sT', '-T4', '--min-rate', '800',
                   '--open', @spec, '-oG', '-', $host);
        my @ports;
        if (open my $fh, '-|', @cmd) {
            while (<$fh>) {
                next unless /Ports:\s*(.+)/;
                for my $e (split /,\s*/, $1) { push @ports, $1 if $e =~ m{^(\d+)/open/tcp} }
            }
            close $fh;
        }
        return [ sort { $a <=> $b } @ports ];
    }
    # pure-Perl fallback: connect-scan the camera port set (can't do 65535 fast)
    print "nmap not found — connect-scanning the camera port set on $host...\n";
    my @open;
    for my $p (@CAMERA_PORTS) {
        my $s = IO::Socket::INET->new(PeerAddr => $host, PeerPort => $p,
                                      Proto => 'tcp', Timeout => 1);
        if ($s) { push @open, $p; close $s }
    }
    return [ @open ];
}

# ---- low-level send/recv --------------------------------------------------
sub connect_tcp {
    my ($host, $port) = @_;
    return IO::Socket::INET->new(PeerAddr => $host, PeerPort => $port,
                                 Proto => 'tcp', Timeout => $opt{timeout});
}
sub send_recv {
    my ($host, $port, $payload, $max) = @_;
    $max //= 8192;
    my $sock = connect_tcp($host, $port) or return undef;
    binmode $sock;
    if (defined $payload && length $payload) {
        local $SIG{PIPE} = 'IGNORE';
        syswrite($sock, $payload) or do { close $sock; return undef };
    }
    my $sel = IO::Select->new($sock);
    my $buf = '';
    my $wait = $opt{timeout};      # wait the full timeout for the FIRST byte
    while (length($buf) < $max && $sel->can_read($wait)) {
        my $n = sysread($sock, my $chunk, 4096);
        last if !defined $n || $n == 0;
        $buf .= $chunk;
        $wait = 0.4;               # after data arrives, only a short inter-chunk grace
    }
    close $sock;
    return $buf;
}

# ---- protocol probes ------------------------------------------------------
# Returns (level, path, detail): level 2 = real ONVIF, 1 = SOAP endpoint
# (probably ONVIF requiring auth), 0 = no. Bails after the first path unless the
# port actually speaks HTTP/SOAP — so a non-web port costs one probe, not four.
sub onvif_check {
    my ($host, $port) = @_;
    my $http_seen = 0;
    for my $path ('/onvif/device_service', '/onvif/device', '/onvif/services', '/') {
        my $req = "POST $path HTTP/1.1\r\n"
                . "Host: $host:$port\r\n"
                . "Content-Type: application/soap+xml; charset=utf-8; "
                . "action=\"http://www.onvif.org/ver10/device/wsdl/GetSystemDateAndTime\"\r\n"
                . "Content-Length: " . length($ONVIF_SOAP) . "\r\n"
                . "Connection: close\r\n\r\n" . $ONVIF_SOAP;
        my $resp = send_recv($host, $port, $req);
        if (defined $resp && length $resp) {
            warn "  [onvif $port$path]\n$resp\n" if $opt{verbose};
            if ($resp =~ /GetSystemDateAndTimeResponse|onvif\.org\/ver10|<tds:|SystemDateAndTime/i) {
                my ($det) = $resp =~ m{<[^>]*(?:Manufacturer|Model)>([^<]+)}i;
                return (2, $path, $det ? "model=$det" : 'GetSystemDateAndTime OK');
            }
            # A SOAP envelope/fault, or a gSOAP server, means a SOAP endpoint lives
            # here (often ONVIF wanting WS-Security auth even for this verb).
            if ($resp =~ /<(?:SOAP-ENV|s|env|soap):Envelope|soap\+xml|<[^>]*Fault>/i
                || $resp =~ /^Server:\s*gSOAP/mi) {
                return (1, $path, 'SOAP/gSOAP endpoint (ONVIF likely; auth required)');
            }
            $http_seen = 1 if $resp =~ m{^HTTP/}i;
        }
        # First path drew nothing HTTP-shaped -> not a web/ONVIF port; stop here
        # rather than waste three more full-timeout probes on it.
        last unless $http_seen;
    }
    return (0, undef, undef);
}

# ---- ONVIF media: ask the camera for its own stream URLs -------------------
#
# GetStreamUri is the authoritative answer. Guessing RTSP paths is the usual
# approach and it is wrong often enough to be useless: the path varies by
# firmware, by channel, and by substream, and a wrong guess fails identically
# to a wrong password. The camera already knows; this asks it.
#
# Unlike GetSystemDateAndTime, these verbs are auth-gated, so they carry a
# WS-Security UsernameToken. A camera with different credentials returns a
# SOAP fault, which is reported as such rather than silently yielding nothing.
sub wsse_header {
    my ($user, $pass) = @_;
    return '' unless defined $user && length $user;
    # Nonce must be raw bytes for the digest and base64 on the wire.
    my $nonce = join '', map { chr(int(rand(256))) } 1 .. 16;
    my @t = gmtime(time);
    my $created = sprintf('%04d-%02d-%02dT%02d:%02d:%02dZ',
                          $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1], $t[0]);
    my $digest = encode_base64(sha1($nonce . $created . (defined $pass ? $pass : '')), '');
    my $n64    = encode_base64($nonce, '');
    return '<s:Header><Security s:mustUnderstand="1"'
         . ' xmlns="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd">'
         . '<UsernameToken><Username>' . _xml($user) . '</Username>'
         . '<Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-username-token-profile-1.0#PasswordDigest">'
         . $digest . '</Password>'
         . '<Nonce EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">'
         . $n64 . '</Nonce>'
         . '<Created xmlns="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd">'
         . $created . '</Created>'
         . '</UsernameToken></Security></s:Header>';
}

sub _xml { my $s = shift; $s =~ s/&/&amp;/g; $s =~ s/</&lt;/g; $s =~ s/>/&gt;/g; return $s }

sub soap_post {
    my ($host, $port, $path, $action, $body, $user, $pass) = @_;
    my $env = '<?xml version="1.0" encoding="UTF-8"?>'
            . '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"'
            . ' xmlns:trt="http://www.onvif.org/ver10/media/wsdl"'
            . ' xmlns:tt="http://www.onvif.org/ver10/schema">'
            . wsse_header($user, $pass)
            . '<s:Body>' . $body . '</s:Body></s:Envelope>';
    my $req = "POST $path HTTP/1.1\r\nHost: $host:$port\r\n"
            . "Content-Type: application/soap+xml; charset=utf-8; action=\"$action\"\r\n"
            . "Content-Length: " . length($env) . "\r\nConnection: close\r\n\r\n" . $env;
    # 64K, not the 8K default: a GetProfiles response carries every profile's
    # full video/audio/PTZ configuration and overruns 8K easily. Truncating it
    # does not fail loudly — it silently cuts the stream URI mid-string, which
    # then looks like a camera returning a malformed URL.
    return send_recv($host, $port, $req, 65536);
}

# Camera XML is entity-encoded, and some firmwares DOUBLE-encode: the wire
# carries &amp;amp; for a single &. Decode repeatedly until it settles so the
# printed URL is the one a player actually needs, but cap the passes so a URL
# legitimately containing "&amp;" cannot loop.
sub xml_decode {
    my ($s) = @_;
    return $s unless defined $s;
    for (1 .. 3) {
        my $before = $s;
        $s =~ s/&lt;/</g;
        $s =~ s/&gt;/>/g;
        $s =~ s/&quot;/"/g;
        $s =~ s/&apos;/'/g;
        $s =~ s/&#(\d+);/chr($1)/ge;
        $s =~ s/&amp;/&/g;
        last if $s eq $before;
    }
    return $s;
}

# Returns ( [ name, token, uri ], ... ) plus a diagnostic string.
sub onvif_stream_uris {
    my ($host, $port, $path, $user, $pass) = @_;
    my @out;
    my $why;
    # The media service often lives at its own path; try the device path too,
    # since plenty of firmwares serve every service from one endpoint.
    for my $mpath ($path, '/onvif/media_service', '/onvif/media', '/onvif/services') {
        my $resp = soap_post($host, $port, $mpath,
                             'http://www.onvif.org/ver10/media/wsdl/GetProfiles',
                             '<trt:GetProfiles/>', $user, $pass);
        next unless defined $resp && length $resp;
        warn "  [media $port$mpath GetProfiles]\n$resp\n" if $opt{verbose};
        if ($resp =~ /<[^>]*Fault>/i) {
            my ($t) = $resp =~ m{<[^>]*(?:Text|faultstring)[^>]*>([^<]+)}i;
            $why = 'GetProfiles refused' . ($t ? ": $t" : ' (credentials?)');
            next;
        }
        my @tokens = $resp =~ /<[^>]*Profiles[^>]*\btoken="([^"]+)"/gi;
        @tokens    = $resp =~ /\btoken="([^"]+)"/gi unless @tokens;
        my @names  = $resp =~ m{<[^>]*:?Name>([^<]+)</[^>]*:?Name>}gi;
        next unless @tokens;
        my $i = 0;
        for my $tok (@tokens) {
            my $nm = $names[$i++] // $tok;
            my $sr = soap_post($host, $port, $mpath,
                        'http://www.onvif.org/ver10/media/wsdl/GetStreamUri',
                        '<trt:GetStreamUri><trt:StreamSetup>'
                      . '<tt:Stream>RTP-Unicast</tt:Stream>'
                      . '<tt:Transport><tt:Protocol>RTSP</tt:Protocol></tt:Transport>'
                      . '</trt:StreamSetup>'
                      . '<trt:ProfileToken>' . _xml($tok) . '</trt:ProfileToken>'
                      . '</trt:GetStreamUri>', $user, $pass);
            next unless defined $sr;
            warn "  [media $port GetStreamUri $tok]\n$sr\n" if $opt{verbose};
            my ($uri) = $sr =~ m{<[^>]*:?Uri>([^<]+)</[^>]*:?Uri>}i;
            $uri = xml_decode($uri);
            push @out, [ $nm, $tok, $uri ] if $uri;
        }
        last if @out;
    }
    return (\@out, $why);
}

# ---- URI testing and frame sampling ---------------------------------------
#
# Two separate jobs, because they fail independently and a camera can do one
# without the other:
#
#   1. TEST the RTSP URI - a DESCRIBE handshake, pure Perl, no decoder. It
#      proves the URI is live, says whether credentials are demanded, and
#      reports the codec from the SDP. That last one matters more than it
#      looks: an H.265 stream plays in VLC and defeats plenty of NVR software,
#      so "VLC works but ZoneMinder does not" is answered here rather than by
#      guesswork.
#
#   2. SAMPLE a frame - via ONVIF GetSnapshotUri, which returns a JPEG over
#      HTTP. Deliberately NOT by decoding RTSP: that needs ffmpeg, which is not
#      installed anywhere on this fleet, whereas a JPEG needs nothing at all.
#      If the camera has no snapshot service we say so rather than pretending.
sub rtsp_describe {
    my ($uri, $user, $pass) = @_;
    my ($host, $port, $path) = $uri =~ m{^rtsp://(?:[^@/]*@)?([^:/]+)(?::(\d+))?(/.*)?$};
    return { error => "unparseable RTSP URI" } unless defined $host;
    $port ||= 554;
    $path = '/' unless defined $path && length $path;
    my $sock = connect_tcp($host, $port) or return { error => "connect $host:$port failed" };
    my $req = "DESCRIBE rtsp://$host:$port$path RTSP/1.0\r\nCSeq: 1\r\n"
            . "Accept: application/sdp\r\nUser-Agent: net-onvif\r\n";
    if (defined $user && length $user) {
        require MIME::Base64;
        $req .= "Authorization: Basic "
             . MIME::Base64::encode_base64("$user:" . (defined $pass ? $pass : ''), '') . "\r\n";
    }
    $req .= "\r\n";
    print {$sock} $req;
    my $resp = '';
    eval {
        local $SIG{ALRM} = sub { die "timeout\n" };
        alarm($opt{timeout} || 3);
        while (my $l = <$sock>) { $resp .= $l; last if length($resp) > 65536 }
        alarm 0;
        1;
    };
    close $sock;
    my ($status) = $resp =~ m{^RTSP/1\.0\s+(\d+)\s*([^\r\n]*)};
    my $reason   = $2 // '';
    my %r = (status => $status, reason => $reason, raw => $resp);
    $r{auth} = ($resp =~ /WWW-Authenticate:\s*(\w+)/i) ? $1 : undef;
    my @codecs = $resp =~ /a=rtpmap:\d+\s+([A-Za-z0-9-]+)/g;
    $r{codecs} = \@codecs if @codecs;
    ($r{dimensions}) = $resp =~ /a=x-dimensions:\s*([0-9,\s]+)/i;
    ($r{framerate})  = $resp =~ /a=framerate:\s*([0-9.]+)/i;
    return \%r;
}

# GetSnapshotUri per profile. Same endpoint-guessing as the stream lookup: a
# firmware that serves media from an unexpected path serves snapshots there too.
sub onvif_snapshot_uris {
    my ($host, $port, $path, $user, $pass) = @_;
    my (@out, $why);
    for my $mpath ($path, '/onvif/media_service', '/onvif/media', '/onvif/services') {
        my $resp = soap_post($host, $port, $mpath,
                             'http://www.onvif.org/ver10/media/wsdl/GetProfiles',
                             '<trt:GetProfiles/>', $user, $pass);
        next unless defined $resp && length $resp;
        if ($resp =~ /<[^>]*Fault>/i) {
            my ($t) = $resp =~ m{<[^>]*(?:Text|faultstring)[^>]*>([^<]+)}i;
            $why = 'GetProfiles refused' . ($t ? ": $t" : ' (credentials?)');
            next;
        }
        my @tokens = $resp =~ /<[^>]*Profiles[^>]*\btoken="([^"]+)"/gi;
        @tokens    = $resp =~ /\btoken="([^"]+)"/gi unless @tokens;
        next unless @tokens;
        for my $tok (@tokens) {
            my $sr = soap_post($host, $port, $mpath,
                        'http://www.onvif.org/ver10/media/wsdl/GetSnapshotUri',
                        '<trt:GetSnapshotUri><trt:ProfileToken>' . _xml($tok)
                      . '</trt:ProfileToken></trt:GetSnapshotUri>', $user, $pass);
            next unless defined $sr;
            warn "  [media $port GetSnapshotUri $tok]\n$sr\n" if $opt{verbose};
            my ($uri) = $sr =~ m{<[^>]*:?Uri>([^<]+)</[^>]*:?Uri>}i;
            push @out, [ $tok, xml_decode($uri) ] if $uri;
        }
        last if @out;
    }
    return (\@out, $why);
}

# Pull one frame off the RTSP stream with ffmpeg. This is the strongest test
# available: DESCRIBE only proves the server answers, whereas a decoded frame
# proves transport, negotiation AND codec support end to end - which is exactly
# the gap between "VLC plays it" and "the NVR shows black".
#
# TCP transport by default: UDP loses NAL units on any congested segment and
# fails in a way that looks like a broken camera rather than a lost packet.
sub ffmpeg_grab {
    my ($uri, $dest, $bin) = @_;
    $bin ||= 'ffmpeg';
    my $have = `sh -c 'command -v $bin' 2>/dev/null`;
    return "not found (pass --ffmpeg PATH, or use the ONVIF snapshot instead)"
        unless $have =~ /\S/;
    my @cmd = ($bin, '-nostdin', '-loglevel', 'error',
               '-rtsp_transport', 'tcp', '-i', $uri,
               '-frames:v', '1', '-y', $dest);
    # Bound it: a camera that accepts the connection and then never sends media
    # would otherwise hang here indefinitely.
    my $to = `sh -c 'command -v timeout' 2>/dev/null`;
    unshift @cmd, 'timeout', '25' if $to =~ /\S/;
    my $rc = system(@cmd);
    return "ffmpeg rc " . ($rc >> 8) if $rc != 0;
    return "produced no frame" unless -s $dest;
    return undef;
}

# Fetch a snapshot to a file. curl rather than a hand-rolled client because
# cameras habitually demand DIGEST auth, and reimplementing that here to save
# one dependency would be a poor trade - curl is already relied on by net-ddns.
sub fetch_snapshot {
    my ($url, $user, $pass, $dest) = @_;
    my $curl = `sh -c 'command -v curl' 2>/dev/null`;
    return "curl not found - cannot fetch the snapshot" unless $curl =~ /\S/;
    # On Cygwin, `curl` is usually Windows' curl.exe, which cannot write to a
    # /cygdrive or /tmp path and fails with rc 23 (write error) - a message that
    # reads like a camera fault. Hand it a native path when cygpath is present.
    my $out = $dest;
    if (`sh -c 'command -v cygpath' 2>/dev/null` =~ /\S/) {
        my $w = `cygpath -w "$dest" 2>/dev/null`;
        chomp $w;
        $out = $w if length $w;
    }
    my @cmd = ('curl', '-sS', '--max-time', 15, '-o', $out);
    push @cmd, '--anyauth', '--user', "$user:" . (defined $pass ? $pass : '')
        if defined $user && length $user;
    push @cmd, $url;
    # Capture the HTTP status: a camera whose snapshot service is broken answers
    # 500 with an empty body, and "no data returned" makes that look like a
    # network problem rather than the firmware fault it is.
    push @cmd, '-w', '%{http_code}';
    my $code = `@{[ join ' ', map { my $x=$_; $x =~ s/'/'\''/g; "'$x'" } @cmd ]} 2>/dev/null`;
    chomp $code;
    return "HTTP $code from the snapshot URL (camera-side failure)"
        if length $code && $code !~ /^2\d\d$/;
    return "no data returned (HTTP $code)" unless -s $dest;
    # A camera that wants credentials often answers 401 with an HTML body and
    # HTTP 200-looking plumbing, so check we actually got an image.
    open my $fh, '<', $dest or return "cannot read $dest";
    binmode $fh; read $fh, my $magic, 4; close $fh;
    return "not a JPEG/PNG (got " . unpack('H*', $magic) . ") - wrong credentials?"
        unless $magic =~ /^\xFF\xD8/ || $magic =~ /^\x89PNG/;
    return undef;
}

# Hand the frame to whatever the desktop uses. Deliberately not a Tk viewer:
# Tk's core image formats are GIF/PPM, so showing a JPEG would need Tk::JPEG
# or Img - another dependency, on every box, to display a file the OS already
# knows how to open.
sub show_file {
    my ($path) = @_;
    for my $c (['cygstart', $path], ['xdg-open', $path], ['open', $path]) {
        my $bin = `sh -c 'command -v $c->[0]' 2>/dev/null`;
        next unless $bin =~ /\S/;
        system(@$c);
        return $c->[0];
    }
    return undef;
}

# Report on one RTSP URI: is it live, does it want credentials, what codec is
# it. Printed rather than returned because this is the answer an operator came
# for - "why does VLC play it and my NVR not".
sub report_rtsp {
    my ($label, $uri, $user, $pass) = @_;
    my $r = rtsp_describe($uri, $user, $pass);
    if ($r->{error}) { printf "  test %-14s ERROR %s\n", $label, $r->{error}; return 0 }
    my $st = $r->{status} // '?';
    printf "  test %-14s RTSP %s %s\n", $label, $st, ($r->{reason} // '');
    if ($r->{auth} && $st eq '401') {
        printf "        needs %s auth - supply --user/--pass\n", $r->{auth};
        return 0;
    }
    printf "        codec: %s\n", join(', ', @{ $r->{codecs} }) if $r->{codecs};
    printf "        dimensions: %s\n", $r->{dimensions} if $r->{dimensions};
    printf "        framerate: %s\n", $r->{framerate}  if $r->{framerate};
    # The single most useful thing this tool can say to someone whose NVR is
    # showing a black frame.
    if ($r->{codecs} && grep { /^H265$/i } @{ $r->{codecs} }) {
        print  "        NOTE: H.265. VLC handles it; many NVRs (ZoneMinder among\n"
             . "              them) need an ffmpeg built with HEVC and often cannot\n"
             . "              DECODE it for motion analysis. Prefer an H.264\n"
             . "              substream there, or record with passthrough.\n";
    }
    return ($st eq '200') ? 1 : 0;
}

# ---- PTZ ------------------------------------------------------------------
#
# ContinuousMove + Stop rather than RelativeMove: continuous is far more widely
# implemented on cheap cameras, and a keypress maps onto it cleanly as "move
# while held" approximated by a short dwell. A terminal cannot see key RELEASE,
# so each press moves for --ptz-dwell seconds and then stops. Without the
# explicit Stop the camera keeps panning until it hits its limit, which is the
# single most alarming way to get this wrong.
sub ptz_soap {
    my ($host, $port, $path, $action, $body, $user, $pass) = @_;
    my $env = '<?xml version="1.0" encoding="UTF-8"?>'
            . '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"'
            . ' xmlns:tptz="http://www.onvif.org/ver20/ptz/wsdl"'
            . ' xmlns:tt="http://www.onvif.org/ver10/schema">'
            . wsse_header($user, $pass)
            . '<s:Body>' . $body . '</s:Body></s:Envelope>';
    my $req = "POST $path HTTP/1.1\r\nHost: $host:$port\r\n"
            . "Content-Type: application/soap+xml; charset=utf-8; action=\"$action\"\r\n"
            . "Content-Length: " . length($env) . "\r\nConnection: close\r\n\r\n" . $env;
    return send_recv($host, $port, $req, 65536);
}

sub ptz_move {
    my ($h, $p, $path, $tok, $x, $y, $z, $u, $pw) = @_;
    my $vel = '<tt:PanTilt x="' . $x . '" y="' . $y . '"/>'
            . '<tt:Zoom x="' . $z . '"/>';
    return ptz_soap($h, $p, $path,
        'http://www.onvif.org/ver20/ptz/wsdl/ContinuousMove',
        '<tptz:ContinuousMove><tptz:ProfileToken>' . _xml($tok) . '</tptz:ProfileToken>'
      . '<tptz:Velocity>' . $vel . '</tptz:Velocity></tptz:ContinuousMove>', $u, $pw);
}

sub ptz_stop {
    my ($h, $p, $path, $tok, $u, $pw) = @_;
    return ptz_soap($h, $p, $path,
        'http://www.onvif.org/ver20/ptz/wsdl/Stop',
        '<tptz:Stop><tptz:ProfileToken>' . _xml($tok) . '</tptz:ProfileToken>'
      . '<tptz:PanTilt>true</tptz:PanTilt><tptz:Zoom>true</tptz:Zoom></tptz:Stop>', $u, $pw);
}

# Interactive steering. Returns 0 on clean exit, non-zero if PTZ was unusable.
sub ptz_drive {
    my ($h, $p, $dev_path, $u, $pw, $speed, $dwell) = @_;

    my ($profiles) = onvif_stream_uris($h, $p, $dev_path, $u, $pw);
    my $tok;
    $tok = $profiles->[0][1] if @$profiles;
    unless ($tok) {
        # Fall back to GetProfiles alone: a camera can have PTZ without giving
        # up a stream URI (auth scoped differently, or no media profile).
        for my $mp ($dev_path, '/onvif/ptz_service', '/onvif/media_service', '/onvif/services') {
            my $r = soap_post($h, $p, $mp,
                    'http://www.onvif.org/ver10/media/wsdl/GetProfiles',
                    '<trt:GetProfiles/>', $u, $pw);
            next unless defined $r && $r !~ /<[^>]*Fault>/i;
            ($tok) = $r =~ /\btoken="([^"]+)"/i;
            last if $tok;
        }
    }
    unless ($tok) {
        print "PTZ: no profile token — camera did not answer GetProfiles"
            . " (credentials?).\n";
        return 1;
    }

    # The PTZ service usually lives on its own path.
    my $ptz_path;
    for my $cand ('/onvif/ptz_service', $dev_path, '/onvif/ptz', '/onvif/services') {
        my $r = ptz_soap($h, $p, $cand,
                'http://www.onvif.org/ver20/ptz/wsdl/Stop',
                '<tptz:Stop><tptz:ProfileToken>' . _xml($tok) . '</tptz:ProfileToken>'
              . '<tptz:PanTilt>true</tptz:PanTilt></tptz:Stop>', $u, $pw);
        next unless defined $r && length $r;
        # A fault still proves the verb reached a PTZ service; a 404 or silence
        # does not. Take the first path that speaks PTZ at all.
        if ($r =~ /StopResponse/i || $r =~ /ver20\/ptz/i) { $ptz_path = $cand; last }
    }
    unless ($ptz_path) {
        print "PTZ: no PTZ service responded (this camera may be fixed-mount).\n";
        return 1;
    }

    printf "PTZ ready on %s  profile=%s  speed=%.2f dwell=%.1fs\n",
           $ptz_path, $tok, $speed, $dwell;
    print "  arrows = pan/tilt   + / - = zoom   . = stop   q = quit\n";

    my $raw = system('stty raw -echo min 1 time 0 2>/dev/null') == 0;
    my $rc  = 0;
    local $SIG{INT} = sub { };          # Ctrl-C should restore the terminal, not skip it
    eval {
        while (1) {
            my $c;
            last unless defined sysread(\*STDIN, $c, 1);
            my ($x, $y, $z) = (0, 0, 0);
            if ($c eq "\e") {           # arrow keys arrive as ESC [ A..D
                my $rest = '';
                sysread(\*STDIN, $rest, 2);
                my $k = substr($rest, 1, 1);
                $y =  $speed if $k eq 'A';
                $y = -$speed if $k eq 'B';
                $x =  $speed if $k eq 'C';
                $x = -$speed if $k eq 'D';
            }
            elsif ($c eq '+' || $c eq '=') { $z =  $speed }
            elsif ($c eq '-' || $c eq '_') { $z = -$speed }
            elsif (lc $c eq 'q')           { last }
            elsif ($c eq '.')              { ptz_stop($h,$p,$ptz_path,$tok,$u,$pw); next }
            else                           { next }
            next unless $x || $y || $z;
            ptz_move($h, $p, $ptz_path, $tok, $x, $y, $z, $u, $pw);
            select(undef, undef, undef, $dwell);
            ptz_stop($h, $p, $ptz_path, $tok, $u, $pw);
        }
        1;
    } or do { $rc = 1 };
    system('stty sane 2>/dev/null') if $raw;
    print "\nPTZ: stopped.\n";
    # Belt and braces: whatever happened above, leave the camera stationary.
    ptz_stop($h, $p, $ptz_path, $tok, $u, $pw);
    return $rc;
}

# Cameras publish the URL without credentials; a player needs them inline.
sub with_creds {
    my ($uri, $user, $pass) = @_;
    return $uri unless defined $user && length $user;
    return $uri if $uri =~ m{^rtsp://[^/@]*@};       # already carries some
    $uri =~ s{^rtsp://}{rtsp://$user:$pass\@};
    return $uri;
}

sub rtsp_options {
    my ($host, $port) = @_;
    my $req = "OPTIONS rtsp://$host:$port/ RTSP/1.0\r\nCSeq: 1\r\n"
            . "User-Agent: net-onvif\r\n\r\n";
    my $resp = send_recv($host, $port, $req, 2048);
    return (0, undef) unless defined $resp && $resp =~ m{^RTSP/1\.\d\s+(\d+)}i;
    warn "  [rtsp $port]\n$resp\n" if $opt{verbose};
    my ($pub) = $resp =~ /^Public:\s*(.+?)\r?$/mi;
    return (1, $pub ? "methods: $pub" : undef);
}

sub http_probe {
    my ($host, $port) = @_;
    my $req = "GET / HTTP/1.1\r\nHost: $host:$port\r\n"
            . "User-Agent: net-onvif\r\nAccept: */*\r\nConnection: close\r\n\r\n";
    my $resp = send_recv($host, $port, $req, 4096);
    return (undef, undef, undef) unless defined $resp && $resp =~ m{^HTTP/\d\.\d\s+(\d+)}i;
    my $stat = $1;
    my ($server) = $resp =~ /^Server:\s*(.+?)\r?$/mi;
    my ($realm)  = $resp =~ /^WWW-Authenticate:\s*\w+\s+realm="?([^"\r\n]+)/mi;
    warn "  [http $port] status=$stat server=" . ($server // '-') . "\n" if $opt{verbose};
    return ($stat, $server, $realm);
}

# UDP WS-Discovery unicast probe — returns the first XAddrs service URL or undef.
sub ws_discovery {
    my ($host) = @_;
    my $mid = 'uuid:' . join('-', map { sprintf '%04x', ($_ * 4243 + 7) % 65536 } 1..8);
    my $probe =
      '<?xml version="1.0" encoding="UTF-8"?>'
    . '<e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope"'
    . ' xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing"'
    . ' xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery"'
    . ' xmlns:dn="http://www.onvif.org/ver10/network/wsdl">'
    . "<e:Header><w:MessageID>$mid</w:MessageID>"
    . '<w:To e:mustUnderstand="true">urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To>'
    . '<w:Action e:mustUnderstand="true">http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</w:Action>'
    . '</e:Header><e:Body><d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types>'
    . '</d:Probe></e:Body></e:Envelope>';
    my $sock = IO::Socket::INET->new(Proto => 'udp', PeerAddr => $host, PeerPort => 3702)
        or return undef;
    $sock->send($probe);
    my $sel = IO::Select->new($sock);
    if ($sel->can_read($opt{timeout})) {
        my $reply; $sock->recv($reply, 65535);
        close $sock;
        return undef unless defined $reply;
        warn "  [ws-discovery]\n$reply\n" if $opt{verbose};
        my ($x) = $reply =~ m{<[^>]*XAddrs>\s*(\S+?)\s*</[^>]*XAddrs>}i;
        return $x;
    }
    close $sock;
    return undef;
}

sub usage {
    my ($rc) = @_;
    print <<'USAGE';
net-onvif — find a camera's ONVIF / RTSP services, even on non-standard ports.

  net-onvif <name|ip> [--fast|--full] [--ports LIST] [--timeout SEC]
            [--user U] [--pass P | --pass-file F | --ask]
            [--listen H:P] [-v]

  <name|ip>       camera to probe; a name is resolved via net-lookup
  --fast          scan a wide camera-port SET instead of all 65535 (quicker)
  --ports LIST    probe only these ports (e.g. 80,554,8000-8100); skips scanning
  --timeout N     per-probe timeout seconds (default 3)  -v  dump raw responses
  --user U        ONVIF username (default admin)
  --pass P        password on the command line — visible in ps and shell history
  --pass-file F   read it from F instead (first line)
  --ask           prompt for it, echo off      (or set NET_ONVIF_PASS)
  --ptz           steer the camera from the keyboard (needs ONVIF + PTZ):
                    arrows pan/tilt   + / -  zoom   .  stop   q  quit
  --ptz-speed F   velocity 0..1 (default 0.5)
  --ptz-dwell S   seconds to move per keypress (default 0.35)

Discovers every open TCP port, then speaks ONVIF (SOAP GetSystemDateAndTime),
RTSP (OPTIONS), and HTTP to each, plus a UDP WS-Discovery probe. Run it from a
host on the camera's own subnet for accurate results.

Credentials are used to AUTHENTICATE, not just to decorate the printed URL:
GetProfiles/GetStreamUri are auth-gated, and those are what yield the camera's
real RTSP stream paths. A camera that rejects them says so ("Sender not
Authorized") rather than silently returning nothing.

Note the printed RTSP URLs can embed the camera's password, because that is the
URL format these cameras publish — mind where you paste the output.
USAGE
    exit $rc;
}
