#!/usr/bin/perl
# net-gen-dnsmasq — read /etc/net-mgr/dhcp.master (and dhcp.extra) and
# emit a dnsmasq DHCP configuration into /etc/net-mgr/dnsmasq.d/. The
# legacy fix_dhcp(8) generated /etc/dhcp/dhcpd.conf for ISC dhcpd; this
# does the equivalent for dnsmasq, so dnsmasq can serve DHCP from the
# same source-of-truth files.
#
# Usage:
#   net-gen-dnsmasq                       # write zones.conf + hosts.conf
#   net-gen-dnsmasq --print               # dump to stdout, write nothing
#   net-gen-dnsmasq --out DIR             # override output dir
#   net-gen-dnsmasq --reload              # SIGHUP dnsmasq after writing
#   net-gen-dnsmasq --diff                # show diff vs current files, no write
#
# Placeholders (DNSH, DNSX, ROUTER_223, …) are substituted from
# /etc/net-mgr/config [dhcp]. Anything still unsubstituted after the
# pass is treated as a hard error so a typo doesn't silently leak into
# dnsmasq's config.

use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Getopt::Long qw(:config no_ignore_case bundling);
use File::Path qw(make_path);
use File::Basename qw(dirname);
use NetMgr::Config;
use NetMgr::Client;
use NetMgr::Producer::DhcpMaster;

my $print_only;
my $reload;
my $diff;
my $out_dir;
my @files;
my $listen;
my $help;
my $from_db;       # generate from the (relayed) DB instead of dhcp.master
my $test;          # write <file>.new instead of <file>
my $domain_opt;
my @zone_opt;      # CIDR=name overrides for the subnet->zone map
GetOptions(
    'print'    => \$print_only,
    'reload'   => \$reload,
    'diff'     => \$diff,
    'out=s'    => \$out_dir,
    'file=s@'  => \@files,
    'listen=s' => \$listen,
    'from-db'  => \$from_db,
    'test'     => \$test,
    'domain=s' => \$domain_opt,
    'zone=s@'  => \@zone_opt,
    'help|h'   => \$help,
) or do { print STDERR usage(); exit 2 };

if ($help) { print usage(); exit 0 }

sub usage {
    return <<'EOT';
net-gen-dnsmasq — generate per-subnet dnsmasq DHCP config from
dhcp.master / dhcp.extra. Each subnet (matched by /24 prefix) gets its
own dnsmasq-<zone>.conf so it can be shipped to just the AP that
serves that subnet's WiFi.

Usage:
  net-gen-dnsmasq                  Write per-subnet files into [dhcp].out_dir.
  net-gen-dnsmasq --print          Dump generated config to stdout.
  net-gen-dnsmasq --diff           Show diff vs current files; write nothing.
  net-gen-dnsmasq --reload         After writing, SIGHUP the local dnsmasq.
  net-gen-dnsmasq --out DIR        Override output directory.
  net-gen-dnsmasq --file PATH      Override input file(s); repeatable.
                                   Default: /etc/net-mgr/dhcp.master (+ dhcp.extra
                                   if it exists).
EOT
}

my $cfg = NetMgr::Config->load;
my %dhcp_cfg    = %{ $cfg->{dhcp}    || {} };
my %dnsmasq_cfg = %{ $cfg->{dnsmasq} || {} };   # --from-db output dir (gateway include dir)

# DB-driven mode: build the per-zone files from the (relayed) dhcp_reservations
# + machine names rather than dhcp.master, then run through the same
# print/diff/write/reload path. This is what a gateway node runs against its
# local replica. Self-contained so the dhcp.master path below is untouched.
if ($from_db) { gen_from_db(); exit 0 }

$out_dir //= $dhcp_cfg{out_dir} // '/etc/net-mgr/dnsmasq.d';

unless (@files) {
    @files = ('/etc/net-mgr/dhcp.master');
    push @files, '/etc/net-mgr/dhcp.extra' if -e '/etc/net-mgr/dhcp.extra';
}

my @records;
for my $f (@files) {
    -e $f or die "input file not found: $f\n";
    push @records, NetMgr::Producer::DhcpMaster::parse_file($f);
}

# Substitution table: pulled from the dhcp_vars table via the manager
# socket (so the same DB-backed values are used wherever this runs).
# [dhcp] in /etc/net-mgr/config still controls non-placeholder things
# like out_dir.
my %subst;
{
    my $cli = NetMgr::Client->new(listen => $listen);
    $cli->hello(consumer => "net-gen-dnsmasq.$$");
    my $rows = $cli->snapshot(1, 'dhcp_vars');
    $cli->bye;
    for my $r (@$rows) {
        $subst{ $r->{name} } = $r->{value} if defined $r->{value};
    }
}

sub apply_subst {
    my ($s) = @_;
    return $s unless defined $s;
    # Sort by length (longest first) so e.g. ROUTER_223 doesn't get
    # half-rewritten by a shorter ROUTER key.
    for my $k (sort { length($b) <=> length($a) } keys %subst) {
        my $v = $subst{$k};
        next unless defined $v;
        $s =~ s/\Q$k\E/$v/g;
    }
    return $s;
}

my %unresolved;   # placeholder → first context where it was seen
sub check_unresolved {
    my ($where, $s) = @_;
    return unless defined $s;
    # Bare uppercase tokens (DNSH, ROUTER_*, etc.) are placeholders by
    # convention. Anything still matching after subst is a config gap;
    # accumulate them all and report at the end.
    while ($s =~ /\b([A-Z][A-Z0-9_]{2,})\b/g) {
        $unresolved{$1} //= $where;
    }
}

sub report_unresolved {
    return unless %unresolved;
    print STDERR "ERROR: unresolved placeholders — add them to [dhcp] in "
               . "/etc/net-mgr/config:\n";
    for my $k (sort keys %unresolved) {
        printf STDERR "  %-15s  (first seen in: %s)\n", $k, $unresolved{$k};
    }
    exit 1;
}

# ---- emit ----------------------------------------------------------

my @subnets = grep { $_->{type} eq 'subnet' } @records;
my @hosts   = grep { $_->{type} eq 'host'   } @records;

# Default zone tag for subnets without a `# zone=` annotation: just
# the third octet, so e.g. 192.168.223.0 → "223". Mostly cosmetic.
sub zone_tag {
    my ($s) = @_;
    return $s->{zone} if $s->{zone};
    my @oct = split /\./, $s->{net};
    return $oct[2] // 'default';
}

# Bucket hosts into per-subnet groups so each AP only gets the
# dhcp-host entries for its own WiFi. Subnet → zone mapping comes from
# the `# zone=NAME` annotation in dhcp.master; hosts are placed into
# the zone whose /24 their IP falls in. Hosts in a /24 with no zone
# block get bucketed under "dnsmasq-<3rd-octet>" so they're not lost.
sub net_24_of { my $ip = shift; $ip =~ /^(\d+\.\d+\.\d+)\./; return $1 }

my %zone_of_24;   # "192.168.223" → "home"
for my $s (@subnets) {
    next unless $s->{zone};
    $zone_of_24{ net_24_of($s->{net}) } = $s->{zone};
}

sub zone_for_host {
    my ($h) = @_;
    return $zone_of_24{ net_24_of($h->{ip}) } // ('subnet-' . (split /\./, $h->{ip})[2]);
}

# Defaults sourced from dhcp.master (or [dhcp] config). Lease time
# appears on each dhcp-host line; domain-name appears in each
# generated hosts-<zone> file's FQDN column.
my $default_lease = 1440;
my $domain        = '';
{
    my $raw = do { open my $f, '<', $files[0] or die; local $/; <$f> };
    $default_lease = $1 if $raw =~ /\bdefault-lease-time\s+(\d+)\s*;/;
    $default_lease = $dhcp_cfg{host_lease} if $dhcp_cfg{host_lease};
    $domain        = $1 if $raw =~ /\boption\s+domain-name\s+"([^"]+)"/;
    $domain        = $dhcp_cfg{domain} if $dhcp_cfg{domain};
}

sub emit_zone_file {
    my ($zone, $hs) = @_;
    my @sorted = sort {
        my @a = split /\./, $a->{ip};
        my @b = split /\./, $b->{ip};
        ($a[2]<=>$b[2]) || ($a[3]<=>$b[3]) || ($a->{name} cmp $b->{name});
    } @$hs;

    my $out = '';
    my %seen_mac;
    for my $h (@sorted) {
        if (my $prev = $seen_mac{ lc $h->{mac} }) {
            warn "duplicate mac $h->{mac}: skipping '$h->{name}' "
               . "(kept '$prev->{name}' from $prev->{file})\n";
            next;
        }
        $seen_mac{ lc $h->{mac} } = $h;
        $out .= "dhcp-host=$h->{mac},$h->{name},$h->{ip},$default_lease\n";
    }
    return $out;
}

# Hosts-file companion for a zone: one line per host with
#   <ip-padded-25>  <name>\t<fqdn>\tM<mac with '_' instead of ':'>
# matching the legacy fix_dhcp / hosts-<zone> layout. dnsmasq picks
# these up via `addn-hosts=` directives in its main config.
sub emit_hosts_file {
    my ($zone, $hs) = @_;
    my @sorted = sort {
        my @a = split /\./, $a->{ip};
        my @b = split /\./, $b->{ip};
        ($a[2]<=>$b[2]) || ($a[3]<=>$b[3]) || ($a->{name} cmp $b->{name});
    } @$hs;

    my $out = '';
    my %seen_mac;
    for my $h (@sorted) {
        next if $seen_mac{ lc $h->{mac} }++;   # same dedupe rule as DHCP
        my $mac_id = $h->{mac};
        $mac_id =~ s/:/_/g;
        my $fqdn = $domain ? "$h->{name}.$domain" : $h->{name};
        $out .= sprintf "%-25s%s\t%s\tM%s\n",
            $h->{ip}, $h->{name}, $fqdn, $mac_id;
    }
    return $out;
}

# Group hosts by zone.
my %hosts_by_zone;
for my $h (@hosts) {
    push @{ $hosts_by_zone{ zone_for_host($h) } }, $h;
}

my %generated;   # path → content
for my $zone (sort keys %hosts_by_zone) {
    $generated{"$out_dir/dnsmasq-$zone"} =
        emit_zone_file($zone, $hosts_by_zone{$zone});
    $generated{"$out_dir/hosts-$zone"} =
        emit_hosts_file($zone, $hosts_by_zone{$zone});
}

# Run all unresolved-placeholder checks now (against generated text).
for my $p (keys %generated) {
    check_unresolved("file $p", $generated{$p});
}
report_unresolved();

if ($print_only) {
    for my $p (sort keys %generated) {
        print "# === $p ===\n", $generated{$p};
    }
    exit 0;
}

if ($diff) {
    show_diff($_, $generated{$_}) for sort keys %generated;
    exit 0;
}

make_path($out_dir);
for my $p (sort keys %generated) {
    write_atomic($p, $generated{$p});
    print "wrote $p\n";
}

if ($reload) {
    my $rc = sighup_dnsmasq();
    print "reloaded dnsmasq\n" if $rc;
}

# ---- helpers -------------------------------------------------------

sub write_atomic {
    my ($path, $content) = @_;
    my $tmp = "$path.tmp.$$";
    open my $fh, '>', $tmp or die "open $tmp: $!\n";
    print $fh $content;
    close $fh or die "close $tmp: $!\n";
    rename $tmp, $path or die "rename $tmp $path: $!\n";
}

sub show_diff {
    my ($path, $new_content) = @_;
    require File::Temp;
    my $tmp = File::Temp->new;
    print $tmp $new_content;
    $tmp->flush;
    if (-e $path) {
        system 'diff', '-u', $path, "$tmp";
    } else {
        print "+++ would create $path (" . length($new_content) . " bytes)\n";
    }
}

sub sighup_dnsmasq {
    my $pid;
    for my $f (qw(/run/dnsmasq/dnsmasq.pid /var/run/dnsmasq.pid /run/dnsmasq.pid)) {
        next unless -r $f;
        open my $fh, '<', $f or next;
        chomp(my $line = <$fh>);
        close $fh;
        $pid = $line if $line && $line =~ /^\d+$/;
        last if $pid;
    }
    if (!$pid) {
        chomp($pid = `pidof dnsmasq 2>/dev/null` // '');
        $pid = (split /\s+/, $pid)[0];
    }
    if (!$pid) {
        warn "couldn't find dnsmasq pid; not reloaded\n";
        return 0;
    }
    if (!kill 'HUP', $pid) {
        warn "kill HUP $pid: $!\n";
        return 0;
    }
    return 1;
}

# ---- DB-driven generation (--from-db) -------------------------------

sub _net24 { my @o = split /\./, ($_[0] // ''); "$o[0].$o[1].$o[2]" }
sub _ipkey { my @o = split /\./, ($_[0] // '0.0.0.0'); (($o[0]*256+$o[1])*256+$o[2])*256+$o[3] }
# dhcp-host name is the short form: strip the side suffix (-up/-down/-dmz/-home),
# keep -air (a distinct wifi interface). Suffixed names stay in the hosts file.
sub _short { my $n = shift // ''; $n =~ s/-(up|down|dmz|home)$//; return $n }

# An adapter marker says WHICH NIC, not which segment, so it stays at the very
# end of a qualified name: u32u's wifi leg on the dmz is u32u-dmz-air, never
# u32u-air-dmz. That keeps -air readable off the tail no matter how many
# zone/index parts the middle grows. -air is the only such marker in this fleet
# (47 names carry it; the next most common tails, -up/-down, are directional).
sub _split_iface {
    my $n = shift // '';
    return ($n, "-$1") if $n =~ s/-(air)$//i;
    return ($n, '');
}
# reverse of the qualified form, for reporting: strip -air, any index, the zone
sub _dequal { my $n = shift // ''; $n =~ s/-air$//; $n =~ s/-\d+$//; $n =~ s/-[a-z0-9]+$//; $n }
sub _rkey { lc($_[0]{mac} // '') . '|' . ($_[0]{ip} // '') }
sub _dbpath {
    my $base = shift;
    my $dir  = $out_dir // $dnsmasq_cfg{out_dir} // '/usr/local/sgy/conf.d';
    return "$dir/$base" . ($test ? '.new' : '');
}

# Build the per-zone files from dhcp_reservations (+ machine names) and run
# them through the shared print/diff/write/reload path.
#   dnsmasq-<zone>: dhcp-host=MAC,<short name>,IP,<lease>   (name-sort, dedup by MAC)
#   hosts-<zone>:   <ip><suffixed per-side name>\t<fqdn>\tM<mac>  (IP-sort, dedup by IP)
sub gen_from_db {
    my $domain = $domain_opt // $dhcp_cfg{domain} // 'grfx.com';
    my $lease  = $dhcp_cfg{host_lease} // 1440;

    # subnet(/24) -> zone. Site defaults; --zone CIDR=name adds/overrides.
    my %zone_of_24 = ('192.168.15' => 'dmz', '192.168.223' => 'home');
    for my $z (@zone_opt) {
        my ($cidr, $name) = split /=/, $z, 2;
        next unless $cidr && defined $name && length $name;
        $cidr =~ s{/\d+$}{}; $cidr =~ s/\.0$//;      # 192.168.15.0/24 -> 192.168.15
        $zone_of_24{$cidr} = $name;
    }

    my $cli = NetMgr::Client->new(listen => $listen);
    $cli->hello(consumer => "net-gen-dnsmasq.$$");
    my $resv = $cli->snapshot(1, 'dhcp_reservations') || [];
    my $M    = $cli->snapshot(2, 'machines')          || [];
    my $IF   = $cli->snapshot(3, 'interfaces')        || [];
    $cli->bye;

    # mac -> suffixed per-side machine name (for the hosts/DNS file)
    my %mname = map { $_->{id} => $_->{primary_name} } grep { $_->{primary_name} } @$M;
    my %mac2host;
    for my $i (@$IF) {
        next unless $i->{mac} && $i->{machine_id};
        my $n = $mname{ $i->{machine_id} } or next;
        $mac2host{ lc $i->{mac} } = $n;
    }

    my (%by_zone, $skipped);
    for my $r (@$resv) {
        next unless $r->{ip} && $r->{mac};
        my $zone = $zone_of_24{ _net24($r->{ip}) };
        if (!$zone) { $skipped++; next }
        push @{ $by_zone{$zone} }, $r;
    }
    warn "net-gen-dnsmasq: skipped $skipped reservation(s) on subnets with no zone mapping\n" if $skipped;

    # Which hosts have legs in MORE THAN ONE zone? Those are exactly the names
    # dnsmasq cannot answer well: the same bare name lands in several zone files
    # and dnsmasq round-robins between addresses on different segments with no
    # idea which one the asking client can reach. Under
    # [dnsmasq] multihomed = qualified, emit only zone-qualified names for them,
    # leaving the bare name out of dnsmasq's local data — dnsmasq consults that
    # data BEFORE any server=/…/ route, so leaving it in makes such a delegation
    # dead config for precisely these names.
    #
    # Legs are grouped by the MACHINE a MAC belongs to, which is what actually
    # makes them one host: nas3's third reservation is named nas3-dwn2, and only
    # the machine says that it is another nas3 leg rather than a separate device.
    # But machine records here are polluted by hostname collisions, so grouping
    # alone would rewrite the garden sensors Barrel and Beds-1 to their wrongly
    # merged machine's name. Hence the guard below: a reservation is only renamed
    # when its own name is a VARIANT of the machine's base name (nas3-dwn2 is,
    # Barrel is not), which keeps foreign entries dragged in by a bad merge under
    # the names their owners chose.

    # Compute each reservation's emitted name in two passes.
    #
    # Pass 1 groups a host's legs by the MACHINE its MAC belongs to, because
    # that is what actually makes them one host: nas3's third reservation is
    # named nas3-dwn2, and only the machine record says that is another nas3 leg
    # rather than a separate device. A reservation is renamed only when its own
    # name is a VARIANT of the machine's base name — machine records here are
    # polluted by hostname collisions, and without that guard the garden sensors
    # Barrel and Beds-1 get rewritten to their wrongly-merged machine's name.
    #
    # Pass 2 then enforces the property we actually need: NO emitted name may
    # appear in more than one zone. Pass 1 alone does not achieve it, because
    # some hosts have their legs split across separate machine records (dkctv,
    # nas5, spa2100), so their bare name still landed in two zone files and would
    # still shadow the delegation. Anything left spanning zones is qualified here
    # regardless of how its legs are recorded.
    #
    # Names are <base>-<zone>[-<n>][-air]: the zone, then an index only when a
    # host has SEVERAL legs of one adapter kind in that zone (nas3 has two wired
    # legs on .223, so nas3-home-0 and nas3-home-1), then the adapter marker.
    # -air stays LAST so it reads off the tail whatever the middle grows to, and
    # because it distinguishes legs on its own a wired/wireless pair sharing a
    # zone needs no index: u32u-home and u32u-home-air. The index follows IP
    # order so the mapping is stable between runs rather than shifting with hash
    # order. Note -up/-down are NOT zone names: they describe which way traffic
    # leaves (up = toward the Internet), which is orthogonal to which segment an
    # address is on, so they are not reused here.
    my $qualify = lc($dnsmasq_cfg{multihomed} // 'short') eq 'qualified';

    # $group_of decides which legs are ONE HOST (always the machine record, so
    # nas3-dwn2 is recognised as an nas3 leg); $emit_of is the name the file
    # would print if nothing were renamed. They must be separate: pass 2 falls
    # back to $emit_of, and using the machine there would let a polluted machine
    # record rename foreign reservations — the Barrel/Beds-1 corruption.
    my $name_map = sub {
        my ($group_of, $emit_of) = @_;
        my %out;                         # "mac|ip" -> name
        my %sfx;                         # "mac|ip" -> adapter marker ('' or -air)

        # Name one host's legs within one zone. The index distinguishes legs of
        # the SAME adapter kind only: a wired and a wireless leg on one segment
        # already read apart as u32u-home and u32u-home-air, so neither should
        # collect a -0/-1 it does not need.
        my $assign = sub {
            my ($stem, $zone, $rs) = @_;
            my %kind;
            push @{ $kind{ $sfx{ _rkey($_) } // '' } }, $_ for @$rs;
            for my $s (keys %kind) {
                my @k = sort { _ipkey($a->{ip}) <=> _ipkey($b->{ip}) } @{ $kind{$s} };
                my $i = 0;
                for my $r (@k) {
                    $out{ _rkey($r) } = "$stem-$zone" . (@k > 1 ? "-$i" : '') . $s;
                    $i++;
                }
            }
        };

        # The adapter marker is a property of the LEG, so it can only come from
        # the reservation's own name: a machine record holds one name for the
        # whole box and cannot say which of its legs is the wireless one. Taking
        # it from the machine both dropped the marker (amfpc-air -> amfpc-dmz)
        # and spread it to wired legs of a machine that happened to be recorded
        # under an -air name. Computed once here, appended last everywhere.
        $sfx{ _rkey($_) } = ( _split_iface($_->{name} // '') )[1]
            for map { @$_ } values %by_zone;

        my %legs;                        # stem -> zone -> [r]
        for my $zone (keys %by_zone) {
            for my $r (@{ $by_zone{$zone} }) {
                my ($b) = _split_iface($group_of->($r));
                next unless defined $b && length $b;
                push @{ $legs{$b}{$zone} }, $r;
            }
        }
        # pass 1 — machine-grouped legs. Splitting -air off the stem is what
        # lets a machine recorded as u32u-air group with a plain u32u leg.
        for my $base (grep { keys %{ $legs{$_} } > 1 } keys %legs) {
            for my $zone (keys %{ $legs{$base} }) {
                my @own = grep {
                    my $n = lc(( _split_iface($_->{name} // '') )[0]);
                    $n eq lc($base) || index($n, lc($base) . '-') == 0
                } @{ $legs{$base}{$zone} };
                $assign->($base, $zone, \@own) if @own;
            }
        }
        # pass 2 — anything still spanning zones under its emitted name
        my %by_emitted;
        for my $zone (keys %by_zone) {
            for my $r (@{ $by_zone{$zone} }) {
                my ($n) = _split_iface( $out{ _rkey($r) } // $emit_of->($r) );
                next unless defined $n && length $n;
                push @{ $by_emitted{$n}{$zone} }, $r;
            }
        }
        for my $n (grep { keys %{ $by_emitted{$_} } > 1 } keys %by_emitted) {
            $assign->($n, $_, $by_emitted{$n}{$_}) for keys %{ $by_emitted{$n} };
        }
        return \%out;
    };

    my $machine_of = sub { $mac2host{ lc $_[0]{mac} } // $_[0]{name} };
    my $dh_name   = $name_map->($machine_of, sub { _short($_[0]{name} // '') });
    my $host_name = $name_map->($machine_of, $machine_of);
    if (%$dh_name) {
        my %hosts = map { _dequal($_) => 1 } values %$dh_name;
        warn sprintf("net-gen-dnsmasq: %d multi-homed host(s) [%s] — %s
",
                     scalar(keys %hosts), join(',', sort keys %hosts),
                     $qualify ? "emitting zone-qualified names only"
                              : "emitting the bare name in each zone; set "
                              . "[dnsmasq] multihomed = qualified to delegate them");
    }

    my %generated;
    for my $zone (sort keys %by_zone) {
        my @rs = @{ $by_zone{$zone} };

        # dnsmasq-<zone>: curated SHORT name, name-sort, dedup by MAC (keep first + warn)
        my (%seenmac, @dh);
        for my $r (sort { _short($a->{name}) cmp _short($b->{name}) or _ipkey($a->{ip}) <=> _ipkey($b->{ip}) } @rs) {
            my $mac  = lc $r->{mac};
            my $sn   = _short($r->{name});
            $sn = $dh_name->{"$mac|$r->{ip}"} if $qualify && $dh_name->{"$mac|$r->{ip}"};
            if (my $first = $seenmac{$mac}) {
                warn "WARN dnsmasq-$zone duplicate mac $r->{mac}: skipping '$sn' at $r->{ip} (kept $first)\n";
                next;
            }
            $seenmac{$mac} = "$sn\@" . $r->{ip};
            push @dh, "dhcp-host=$mac,$sn,$r->{ip},$lease\n";
        }
        $generated{ _dbpath("dnsmasq-$zone") } = join '', @dh;

        # hosts-<zone>: suffixed per-side machine name, IP-sort, dedup by IP (keep first + warn)
        my (%seenip, @hl);
        for my $r (sort { _ipkey($a->{ip}) <=> _ipkey($b->{ip}) } @rs) {
            if (my $first = $seenip{ $r->{ip} }) {
                warn "WARN hosts-$zone duplicate ip $r->{ip}: skipping (kept $first)\n";
                next;
            }
            $seenip{ $r->{ip} } = ($r->{name} // '?');
            my $mac  = lc $r->{mac};
            my $name = $mac2host{$mac} // $r->{name};
            # Same rule as the dhcp-host line above: a multi-homed host must not
            # appear here under its bare name either, or the hosts file shadows
            # the delegation just as effectively as the DHCP entry would.
            $name = $host_name->{"$mac|$r->{ip}"}
                if $qualify && $host_name->{"$mac|$r->{ip}"};
            next unless defined $name && length $name;
            (my $macid = $mac) =~ s/:/_/g;
            push @hl, sprintf("%-25s%s\t%s\tM%s\n", $r->{ip}, $name, "$name.$domain", $macid);
        }
        $generated{ _dbpath("hosts-$zone") } = join '', @hl;
    }

    _emit_generated(\%generated);
}

sub _emit_generated {
    my ($gen) = @_;
    unless (%$gen) { warn "net-gen-dnsmasq: nothing to generate (no reservations in mapped zones)\n"; return }
    if ($print_only) {
        for my $p (sort keys %$gen) { print "# === $p ===\n", $gen->{$p} }
        return;
    }
    if ($diff) {
        show_diff($_, $gen->{$_}) for sort keys %$gen;
        return;
    }
    for my $p (sort keys %$gen) {
        write_atomic($p, $gen->{$p});
        print "wrote $p\n";
    }
    if ($reload) { my $rc = sighup_dnsmasq(); print "reloaded dnsmasq\n" if $rc }
}
