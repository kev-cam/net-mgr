# Terasic SoCKit (Cyclone V SX 5CSXFC6D6F31C6, Rev D) — network analyzer appliance.
# HPS-only boot (SD): mainline U-Boot SPL (in-tree qts handoff) -> mainline kernel
# socfpga_defconfig + socfpga_cyclone5_sockit.dtb -> busybox rootfs + net-analyzer daemon.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_CCACHE=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/patches"
BR2_TARGET_GENERIC_HOSTNAME="sockit-netan"
BR2_TARGET_GENERIC_ISSUE="SoCKit network analyzer (Cyclone V SX)"
BR2_TARGET_GENERIC_ROOT_PASSWD="netan"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="support/scripts/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/genimage.cfg"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="socfpga"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/linux-extras.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="intel/socfpga/socfpga_cyclone5_sockit"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="120M"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="socfpga_sockit"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-with-spl.sfp"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SOCKIT_NETAN_PATH)/board/sockit_netan/busybox.fragment"
BR2_PACKAGE_ARP_SCAN=y
BR2_PACKAGE_FPING=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPERF3=y
# classic iperf (5001) needs a C++ toolchain, which this build omits; iperf3 only.
BR2_PACKAGE_DROPBEAR=y
# --- WiFi management uplink (RT3070 dongle): wpa_supplicant + iw + dhcpcd ---
# dhcpcd (NOT udhcpc) for wlan: net-analyzer does a GLOBAL `killall udhcpc` each
# cycle, which would strand a udhcpc wlan lease regardless of pidfile.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_DHCPCD=y
# --- BLE (RTL8761BU dongle): bluez (bluetoothctl + btmgmt) ---
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# --- firmware blobs: RALINK_RT2XX ships rt2870.bin; RTL_87XX_BT ships rtl8761bu_* ---
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
