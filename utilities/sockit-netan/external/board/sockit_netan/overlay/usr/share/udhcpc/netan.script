#!/bin/sh
# udhcpc hook for net-analyzer: apply the lease and dump the environment
# so the analyzer can read ip/router/dns/lease/serverid.

LEASE_ENV=/tmp/netan-lease.env

dump_env() {
    {
        echo "ip='$ip'"
        echo "mask='$mask'"
        echo "subnet='$subnet'"
        echo "router='$router'"
        echo "dns='$dns'"
        echo "domain='$domain'"
        echo "broadcast='$broadcast'"
        echo "lease='$lease'"
        echo "serverid='$serverid'"
    } > "$LEASE_ENV.tmp" && mv "$LEASE_ENV.tmp" "$LEASE_ENV"
}

case "$1" in
    deconfig)
        ip addr flush dev "$interface" 2>/dev/null
        rm -f "$LEASE_ENV"
        ;;
    bound|renew)
        # unchanged-address renew: refresh the env dump (lease/router may
        # change) but don't flush — that would drop live connections mid-hold
        if [ "$1" = renew ] && ip addr show dev "$interface" 2>/dev/null \
                | grep -qF " $ip/${mask:-24} "; then
            dump_env
            exit 0
        fi
        ip addr flush dev "$interface" 2>/dev/null
        ip addr add "$ip/${mask:-24}" dev "$interface"
        if [ -n "$router" ]; then
            ip route del default dev "$interface" 2>/dev/null
            for r in $router; do ip route add default via "$r" dev "$interface" && break; done
        fi
        : > /etc/resolv.conf
        for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
        # env dump stays LAST: its appearance tells the analyzer the
        # interface is configured
        dump_env
        ;;
esac
exit 0
