<?xml version="1.0" encoding="utf-8"?>
<!-- Accessibility config for NumberBarnReader.

     packageNames pins the service to NumberBarn alone. An accessibility
     service can otherwise observe every screen on the device, and there is no
     reason for this one to see anything else — narrowing it here is what keeps
     it a bridge rather than something that could read the whole tablet.

     canRetrieveWindowContent is the capability that makes reading the message
     list possible at all. No flagRequestFilterKeyEvents and no
     canPerformGestures: this build only reads. -->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="300"
    android:packageNames="com.numberbarn.app"
    android:description="@string/numberbarn_reader_desc" />
