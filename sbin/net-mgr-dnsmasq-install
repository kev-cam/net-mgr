#!/bin/sh
# net-mgr-dnsmasq-install — post-build configuration for a patched dnsmasq.
#
# Run as root on the target by `make install-dnsmasq-on`, AFTER the fork's own
# ./remake install has put the binary at /usr/local/sbin/dnsmasq. remake does the
# compiling and installing (with the compile-time options read from the target's
# packaged dnsmasq, so swap-dnsmasq can run it with the packaged unit's argv);
# this only does the part remake knows nothing about - pointing dnsmasq at
# net-mgr - and reports what still has to happen by hand.
#
#   net-mgr-dnsmasq-install [/usr/local/src/dnsmasq]
#
# It does NOT activate anything. The patched binary sits alongside the distro one
# until swap-dnsmasq is told to switch, which keeps putting it in place free of
# runtime consequence and leaves the changeover a single reversible command.
set -e
tree=${1:-/usr/local/src/dnsmasq}
bin=/usr/local/sbin/dnsmasq

[ -x "$bin" ] || { echo "no patched binary at $bin - did remake install run?" >&2; exit 2; }
"$bin" --version >/dev/null 2>&1 || { echo "$bin will not execute" >&2; exit 3; }
strings "$bin" | grep -q netmgr || { echo "$bin has no netmgr client" >&2; exit 3; }

# THE line that matters. Without it the patched binary changes nothing: it never
# polls net-mgr, so reservations still never reach the running server - which is
# the entire gateway3 symptom, not the stale build.
conf=/etc/net-mgr/dnsmasq.conf
if [ -f "$conf" ]; then
    if grep -q "^netmgr=" "$conf"; then
        echo "netmgr= already configured in $conf"
    else
        echo "netmgr=127.0.0.1:7531" >> "$conf"
        echo "added netmgr=127.0.0.1:7531 to $conf"
    fi
else
    # Deliberately not created: a file nothing includes would look like the feed
    # was configured while changing nothing at all.
    echo "WARNING: $conf absent - dnsmasq will NOT pull config from net-mgr" >&2
fi

if [ ! -x "$tree/swap-dnsmasq" ]; then
    echo "WARNING: $tree/swap-dnsmasq missing - dnsmasq-switch will fail" >&2
fi

echo "NOT ACTIVATED. The running DHCP server is untouched."
echo "To switch: net-cluster dnsmasq-switch variant=custom   (revert: variant=stock)"
